{
  "$comment": "Validate candidate, scenario-set, and identifier binding with skills_sdk.core.schema_registry.SchemaRegistry.validate.",
  "$defs": {
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "PackageReceiptBlocker": {
      "additionalProperties": false,
      "description": "Stable typed blocker details for a package proof receipt.",
      "properties": {
        "code": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "PackageReceiptBlocker",
      "type": "object"
    },
    "ProviderIdentityV2": {
      "additionalProperties": false,
      "description": "Hardened provider identity for provider-bearing v2 contracts.",
      "properties": {
        "adapter_id": {
          "maxLength": 64,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version_or_digest": {
          "maxLength": 128,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$",
          "title": "Adapter Version Or Digest",
          "type": "string"
        },
        "model_id": {
          "allOf": [
            {
              "not": {
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
              }
            }
          ],
          "maxLength": 128,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*(?:/[A-Za-z0-9][A-Za-z0-9._:+-]*)*$",
          "title": "Model Id",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 64,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_kind": {
          "enum": [
            "llm",
            "agent",
            "external"
          ],
          "title": "Provider Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "provider-identity/v2",
          "default": "provider-identity/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "version_or_digest": {
          "maxLength": 128,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$",
          "title": "Version Or Digest",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "provider_kind",
        "model_id",
        "version_or_digest",
        "adapter_id",
        "adapter_version_or_digest"
      ],
      "title": "ProviderIdentityV2",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/scenario-case-result.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocker": {
            "type": "null"
          },
          "forbidden_commands_observed": {
            "maxItems": 0
          },
          "missing_signals": {
            "maxItems": 0
          },
          "observation_sha256": {
            "type": "string"
          }
        },
        "required": [
          "observation_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fail"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "missing_signals": {
                "minItems": 1
              }
            },
            "required": [
              "missing_signals"
            ]
          },
          {
            "properties": {
              "forbidden_commands_observed": {
                "minItems": 1
              }
            },
            "required": [
              "forbidden_commands_observed"
            ]
          },
          {
            "properties": {
              "output_digest_mismatch": {
                "const": true
              }
            },
            "required": [
              "output_digest_mismatch"
            ]
          }
        ],
        "properties": {
          "blocker": {
            "type": "null"
          },
          "observation_sha256": {
            "type": "string"
          }
        },
        "required": [
          "observation_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocker": {
            "$ref": "#/$defs/PackageReceiptBlocker"
          },
          "observation_sha256": {
            "type": "null"
          }
        },
        "required": [
          "blocker"
        ]
      }
    }
  ],
  "properties": {
    "blocker": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackageReceiptBlocker"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidate": {
      "$ref": "#/$defs/PackageCandidateIdentity"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array",
      "uniqueItems": true
    },
    "expected_output_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Output Sha256"
    },
    "forbidden_commands_observed": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Forbidden Commands Observed",
      "type": "array"
    },
    "missing_signals": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Missing Signals",
      "type": "array"
    },
    "mutation_performed": {
      "const": false,
      "default": false,
      "title": "Mutation Performed",
      "type": "boolean"
    },
    "observation_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation Sha256"
    },
    "output_digest_mismatch": {
      "default": false,
      "title": "Output Digest Mismatch",
      "type": "boolean"
    },
    "provider": {
      "$ref": "#/$defs/ProviderIdentityV2"
    },
    "runner_id": {
      "minLength": 1,
      "title": "Runner Id",
      "type": "string"
    },
    "runner_version_or_digest": {
      "minLength": 1,
      "title": "Runner Version Or Digest",
      "type": "string"
    },
    "scenario_set_id": {
      "minLength": 1,
      "title": "Scenario Set Id",
      "type": "string"
    },
    "schema_version": {
      "const": "scenario-case-result/v2",
      "default": "scenario-case-result/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "candidate",
    "scenario_set_id",
    "case_id",
    "provider",
    "status",
    "runner_id",
    "runner_version_or_digest"
  ],
  "title": "ScenarioCaseResultV2",
  "type": "object",
  "x-skills-sdk-semantic-validator": {
    "entrypoint": "skills_sdk.core.schema_registry.SchemaRegistry.validate",
    "required_for": [
      "scenario result evidence refs and case ids must be unique"
    ]
  }
}
