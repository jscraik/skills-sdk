          "minLength": 1,
          "pattern": "^(?=.*\\S)(?![\\s\\S]*(?:[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890-\\u0891\\u08e2\\u180e\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ufeff\\ufff9-\\ufffb]|\ud804\udcbd|\ud804\udccd|\ud80d\udc30|\ud80d\udc31|\ud80d\udc32|\ud80d\udc33|\ud80d\udc34|\ud80d\udc35|\ud80d\udc36|\ud80d\udc37|\ud80d\udc38|\ud80d\udc39|\ud80d\udc3a|\ud80d\udc3b|\ud80d\udc3c|\ud80d\udc3d|\ud80d\udc3e|\ud80d\udc3f|\ud82f\udca0|\ud82f\udca1|\ud82f\udca2|\ud82f\udca3|\ud834\udd73|\ud834\udd74|\ud834\udd75|\ud834\udd76|\ud834\udd77|\ud834\udd78|\ud834\udd79|\ud834\udd7a|\udb40\udc01|\udb40\udc20|\udb40\udc21|\udb40\udc22|\udb40\udc23|\udb40\udc24|\udb40\udc25|\udb40\udc26|\udb40\udc27|\udb40\udc28|\udb40\udc29|\udb40\udc2a|\udb40\udc2b|\udb40\udc2c|\udb40\udc2d|\udb40\udc2e|\udb40\udc2f|\udb40\udc30|\udb40\udc31|\udb40\udc32|\udb40\udc33|\udb40\udc34|\udb40\udc35|\udb40\udc36|\udb40\udc37|\udb40\udc38|\udb40\udc39|\udb40\udc3a|\udb40\udc3b|\udb40\udc3c|\udb40\udc3d|\udb40\udc3e|\udb40\udc3f|\udb40\udc40|\udb40\udc41|\udb40\udc42|\udb40\udc43|\udb40\udc44|\udb40\udc45|\udb40\udc46|\udb40\udc47|\udb40\udc48|\udb40\udc49|\udb40\udc4a|\udb40\udc4b|\udb40\udc4c|\udb40\udc4d|\udb40\udc4e|\udb40\udc4f|\udb40\udc50|\udb40\udc51|\udb40\udc52|\udb40\udc53|\udb40\udc54|\udb40\udc55|\udb40\udc56|\udb40\udc57|\udb40\udc58|\udb40\udc59|\udb40\udc5a|\udb40\udc5b|\udb40\udc5c|\udb40\udc5d|\udb40\udc5e|\udb40\udc5f|\udb40\udc60|\udb40\udc61|\udb40\udc62|\udb40\udc63|\udb40\udc64|\udb40\udc65|\udb40\udc66|\udb40\udc67|\udb40\udc68|\udb40\udc69|\udb40\udc6a|\udb40\udc6b|\udb40\udc6c|\udb40\udc6d|\udb40\udc6e|\udb40\udc6f|\udb40\udc70|\udb40\udc71|\udb40\udc72|\udb40\udc73|\udb40\udc74|\udb40\udc75|\udb40\udc76|\udb40\udc77|\udb40\udc78|\udb40\udc79|\udb40\udc7a|\udb40\udc7b|\udb40\udc7c|\udb40\udc7d|\udb40\udc7e|\udb40\udc7f))(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Current Path",
          "type": "string"
        },
        "declared_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Version"
        },
        "direct_consumers": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?![\\s\\S]*(?:[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890-\\u0891\\u08e2\\u180e\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ufeff\\ufff9-\\ufffb]|\ud804\udcbd|\ud804\udccd|\ud80d\udc30|\ud80d\udc31|\ud80d\udc32|\ud80d\udc33|\ud80d\udc34|\ud80d\udc35|\ud80d\udc36|\ud80d\udc37|\ud80d\udc38|\ud80d\udc39|\ud80d\udc3a|\ud80d\udc3b|\ud80d\udc3c|\ud80d\udc3d|\ud80d\udc3e|\ud80d\udc3f|\ud82f\udca0|\ud82f\udca1|\ud82f\udca2|\ud82f\udca3|\ud834\udd73|\ud834\udd74|\ud834\udd75|\ud834\udd76|\ud834\udd77|\ud834\udd78|\ud834\udd79|\ud834\udd7a|\udb40\udc01|\udb40\udc20|\udb40\udc21|\udb40\udc22|\udb40\udc23|\udb40\udc24|\udb40\udc25|\udb40\udc26|\udb40\udc27|\udb40\udc28|\udb40\udc29|\udb40\udc2a|\udb40\udc2b|\udb40\udc2c|\udb40\udc2d|\udb40\udc2e|\udb40\udc2f|\udb40\udc30|\udb40\udc31|\udb40\udc32|\udb40\udc33|\udb40\udc34|\udb40\udc35|\udb40\udc36|\udb40\udc37|\udb40\udc38|\udb40\udc39|\udb40\udc3a|\udb40\udc3b|\udb40\udc3c|\udb40\udc3d|\udb40\udc3e|\udb40\udc3f|\udb40\udc40|\udb40\udc41|\udb40\udc42|\udb40\udc43|\udb40\udc44|\udb40\udc45|\udb40\udc46|\udb40\udc47|\udb40\udc48|\udb40\udc49|\udb40\udc4a|\udb40\udc4b|\udb40\udc4c|\udb40\udc4d|\udb40\udc4e|\udb40\udc4f|\udb40\udc50|\udb40\udc51|\udb40\udc52|\udb40\udc53|\udb40\udc54|\udb40\udc55|\udb40\udc56|\udb40\udc57|\udb40\udc58|\udb40\udc59|\udb40\udc5a|\udb40\udc5b|\udb40\udc5c|\udb40\udc5d|\udb40\udc5e|\udb40\udc5f|\udb40\udc60|\udb40\udc61|\udb40\udc62|\udb40\udc63|\udb40\udc64|\udb40\udc65|\udb40\udc66|\udb40\udc67|\udb40\udc68|\udb40\udc69|\udb40\udc6a|\udb40\udc6b|\udb40\udc6c|\udb40\udc6d|\udb40\udc6e|\udb40\udc6f|\udb40\udc70|\udb40\udc71|\udb40\udc72|\udb40\udc73|\udb40\udc74|\udb40\udc75|\udb40\udc76|\udb40\udc77|\udb40\udc78|\udb40\udc79|\udb40\udc7a|\udb40\udc7b|\udb40\udc7c|\udb40\udc7d|\udb40\udc7e|\udb40\udc7f))(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Direct Consumers",
          "type": "array"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "distinctive_value": {
          "minLength": 1,
          "title": "Distinctive Value",
          "type": "string"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "external_dependencies": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "External Dependencies",
          "type": "array"
        },
        "format_checks": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormatChecks"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "intended_disposition": {
          "$ref": "#/$defs/PackageDisposition"
        },
        "maintenance_cost": {
          "minLength": 1,
          "title": "Maintenance Cost",
          "type": "string"
        },
        "mantra": {
          "$ref": "#/$defs/MantraAssessment"
        },
        "overlap_with_existing": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Overlap With Existing",
          "type": "array"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "package_type": {
          "$ref": "#/$defs/PackageType"
        },
        "recommended_mechanism": {
          "$ref": "#/$defs/RecommendedMechanism"
        },
        "rights": {
          "anyOf": [
            {
              "$ref": "#/$defs/RightsStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "risk": {
          "$ref": "#/$defs/RiskClass",
          "default": "none"
        },
        "runtime_visibility": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuntimeVisibility"
          },
          "title": "Runtime Visibility",
          "type": "array"
        },
        "schema_version": {
          "const": "package-inventory/v1",
          "default": "package-inventory/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tessl_identity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tessl Identity"
        },
        "user_outcome": {
          "minLength": 1,
          "title": "User Outcome",
          "type": "string"
        },
        "value_decision": {
          "$ref": "#/$defs/ValueDecision"
        }
      },
      "required": [
        "package_id",
        "package_type",
        "current_path",
        "owner",
        "user_outcome",
        "distinctive_value",
        "maintenance_cost",
        "context_cost",
        "recommended_mechanism",
        "value_decision",
        "mantra",
        "intended_disposition"
      ],
      "title": "PackageInventoryRecord",
      "type": "object"
    },
    "PackageType": {
      "description": "Canonical package categories admitted by the Foundry.",
      "enum": [
        "skill",
        "plugin"
      ],
      "title": "PackageType",
      "type": "string"
    },
    "RecommendedMechanism": {
      "description": "The smallest useful packaging mechanism for a candidate.",
      "enum": [
        "standalone_skill",
        "plugin_bundle",
        "external_source",
        "archive",
        "reject"
      ],
      "title": "RecommendedMechanism",
      "type": "string"
    },
    "RightsStatus": {
      "additionalProperties": false,
      "description": "Rights evidence required before canonical admission.",
      "properties": {
        "basis": {
          "enum": [
            "authored",
            "license",
            "permission"
          ],
          "title": "Basis",
          "type": "string"
        },
        "evidence_ref": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?![\\s\\S]*(?:[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890-\\u0891\\u08e2\\u180e\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ufeff\\ufff9-\\ufffb]|\ud804\udcbd|\ud804\udccd|\ud80d\udc30|\ud80d\udc31|\ud80d\udc32|\ud80d\udc33|\ud80d\udc34|\ud80d\udc35|\ud80d\udc36|\ud80d\udc37|\ud80d\udc38|\ud80d\udc39|\ud80d\udc3a|\ud80d\udc3b|\ud80d\udc3c|\ud80d\udc3d|\ud80d\udc3e|\ud80d\udc3f|\ud82f\udca0|\ud82f\udca1|\ud82f\udca2|\ud82f\udca3|\ud834\udd73|\ud834\udd74|\ud834\udd75|\ud834\udd76|\ud834\udd77|\ud834\udd78|\ud834\udd79|\ud834\udd7a|\udb40\udc01|\udb40\udc20|\udb40\udc21|\udb40\udc22|\udb40\udc23|\udb40\udc24|\udb40\udc25|\udb40\udc26|\udb40\udc27|\udb40\udc28|\udb40\udc29|\udb40\udc2a|\udb40\udc2b|\udb40\udc2c|\udb40\udc2d|\udb40\udc2e|\udb40\udc2f|\udb40\udc30|\udb40\udc31|\udb40\udc32|\udb40\udc33|\udb40\udc34|\udb40\udc35|\udb40\udc36|\udb40\udc37|\udb40\udc38|\udb40\udc39|\udb40\udc3a|\udb40\udc3b|\udb40\udc3c|\udb40\udc3d|\udb40\udc3e|\udb40\udc3f|\udb40\udc40|\udb40\udc41|\udb40\udc42|\udb40\udc43|\udb40\udc44|\udb40\udc45|\udb40\udc46|\udb40\udc47|\udb40\udc48|\udb40\udc49|\udb40\udc4a|\udb40\udc4b|\udb40\udc4c|\udb40\udc4d|\udb40\udc4e|\udb40\udc4f|\udb40\udc50|\udb40\udc51|\udb40\udc52|\udb40\udc53|\udb40\udc54|\udb40\udc55|\udb40\udc56|\udb40\udc57|\udb40\udc58|\udb40\udc59|\udb40\udc5a|\udb40\udc5b|\udb40\udc5c|\udb40\udc5d|\udb40\udc5e|\udb40\udc5f|\udb40\udc60|\udb40\udc61|\udb40\udc62|\udb40\udc63|\udb40\udc64|\udb40\udc65|\udb40\udc66|\udb40\udc67|\udb40\udc68|\udb40\udc69|\udb40\udc6a|\udb40\udc6b|\udb40\udc6c|\udb40\udc6d|\udb40\udc6e|\udb40\udc6f|\udb40\udc70|\udb40\udc71|\udb40\udc72|\udb40\udc73|\udb40\udc74|\udb40\udc75|\udb40\udc76|\udb40\udc77|\udb40\udc78|\udb40\udc79|\udb40\udc7a|\udb40\udc7b|\udb40\udc7c|\udb40\udc7d|\udb40\udc7e|\udb40\udc7f))(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        }
      },
      "required": [
        "basis",
        "license",
        "evidence_ref"
      ],
      "title": "RightsStatus",
      "type": "object"
    },
    "RiskClass": {
      "description": "Inventory risk classification before admission.",
      "enum": [
        "none",
        "review",
        "blocked"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "RuntimeVisibility": {
      "description": "Observed runtime surfaces, kept separate from canonical ownership.",
      "enum": [
        "user_agents",
        "project_agents",
        "codex_plugin_cache",
        "none"
      ],
      "title": "RuntimeVisibility",
      "type": "string"
    },
    "SourceProvenance": {
      "additionalProperties": false,
      "description": "Immutable source identity retained for an inventory candidate.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
