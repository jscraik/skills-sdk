{
  "$defs": {
    "FormatChecks": {
      "additionalProperties": false,
      "description": "Format evidence recorded during read-only package inventory.",
      "properties": {
        "codex_adapter_manifest": {
          "default": false,
          "title": "Codex Adapter Manifest",
          "type": "boolean"
        },
        "root_plugin_manifest": {
          "default": false,
          "title": "Root Plugin Manifest",
          "type": "boolean"
        }
      },
      "title": "FormatChecks",
      "type": "object"
    },
    "MantraAssessment": {
      "additionalProperties": false,
      "description": "The complete nine-part assessment bound to one exact candidate.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "durable_memory": {
          "$ref": "#/$defs/MantraPrinciple"
        },
        "overall": {
          "$ref": "#/$defs/MantraStatus"
        },
        "professional_output": {
          "$ref": "#/$defs/MantraPrinciple"
        },
        "progressive_disclosure": {
          "$ref": "#/$defs/MantraPrinciple"
        },
        "self_improvement": {
          "$ref": "#/$defs/MantraPrinciple"
        },
        "simplicity": {
          "$ref": "#/$defs/MantraPrinciple"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        },
        "strong_guardrails": {
          "$ref": "#/$defs/MantraPrinciple"
        },
        "taste": {
          "$ref": "#/$defs/MantraPrinciple"
        },
        "thin_surfaces": {
          "$ref": "#/$defs/MantraPrinciple"
        },
        "valuemaxxing": {
          "$ref": "#/$defs/MantraPrinciple"
        }
      },
      "required": [
        "source_revision",
        "content_sha256",
        "taste",
        "thin_surfaces",
        "strong_guardrails",
        "simplicity",
        "progressive_disclosure",
        "durable_memory",
        "valuemaxxing",
        "self_improvement",
        "professional_output",
        "overall"
      ],
      "title": "MantraAssessment",
      "type": "object"
    },
    "MantraPrinciple": {
      "additionalProperties": false,
      "description": "Candidate-bound evidence for one engineering-mantra principle.",
      "properties": {
        "evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/MantraStatus"
        }
      },
      "required": [
        "status",
        "evidence"
      ],
      "title": "MantraPrinciple",
      "type": "object"
    },
    "MantraStatus": {
      "description": "Assessment status for one engineering-mantra principle.",
      "enum": [
        "pass",
        "revise",
        "reject"
      ],
      "title": "MantraStatus",
      "type": "string"
    },
    "PackageDisposition": {
      "description": "Explicit inventory outcomes; none imply mutation.",
      "enum": [
        "admit_to_foundry",
        "merge_with_existing",
        "retain_external_source",
        "runtime_only",
        "sdk_fixture_only",
        "archive_with_provenance",
        "reject_duplicate",
        "reject_unsafe",
        "needs_owner_decision"
      ],
      "title": "PackageDisposition",
      "type": "string"
    },
    "PackageInventoryRecord": {
      "additionalProperties": false,
      "description": "One read-only inventory record for a retained skill or plugin.",
