        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "blocker"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "category",
        "severity",
        "message",
        "evidence_refs"
      ],
      "title": "SecurityFinding",
      "type": "object"
    },
    "SecurityScreeningResult": {
      "additionalProperties": false,
      "description": "Candidate-bound secret and unsafe-package screening result.",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SecurityFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "mutation_performed": {
          "const": false,
          "default": false,
          "title": "Mutation Performed",
          "type": "boolean"
        },
        "scanned_paths": {
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Scanned Paths",
          "type": "array"
        },
        "schema_version": {
          "const": "security-screening/v1",
          "default": "security-screening/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sensor_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
