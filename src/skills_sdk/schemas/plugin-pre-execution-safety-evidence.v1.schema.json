      "title": "PortablePluginManifest",
      "type": "object"
    },
    "SecurityFinding": {
      "additionalProperties": false,
      "description": "Redacted finding metadata; raw secret values never enter the contract.",
      "properties": {
        "category": {
          "enum": [
            "secret",
            "unsafe_path",
            "external_service",
            "license",
            "mcp_auth",
            "dependency"
