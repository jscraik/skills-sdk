          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "name",
        "version"
      ],
      "title": "SkillIdentity",
      "type": "object"
    },
    "SkillPackageFinding": {
      "additionalProperties": false,
