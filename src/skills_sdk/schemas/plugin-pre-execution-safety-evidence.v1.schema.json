      "required": [
        "candidate",
        "sensor_ids",
        "status",
        "scanned_paths"
      ],
      "title": "SecurityScreeningResult",
      "type": "object"
    },
    "SkillIdentity": {
      "additionalProperties": false,
      "description": "Agent Skills identity, independent of runtime installation.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
