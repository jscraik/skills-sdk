        "properties": {
          "status": {
            "const": "rolled_back"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocker": {
            "type": "null"
          },
          "mutation_performed": {
            "const": true
          },
          "race": {
            "type": "null"
          },
          "resulting_lock_sha256": {
            "type": "string"
          }
        },
        "required": [
          "resulting_lock_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "rollback_failed",
              "indeterminate"
