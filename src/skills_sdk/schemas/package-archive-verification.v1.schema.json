{
  "$defs": {
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "PackageFileRole": {
      "description": "The portable role of a file included in a package manifest.",
      "enum": [
        "skill_md",
        "readme",
        "reference",
        "script",
        "asset",
        "eval"
      ],
      "title": "PackageFileRole",
      "type": "string"
    },
    "PackageManifest": {
      "additionalProperties": false,
      "description": "Candidate-bound package contents before distribution or installation.",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/PackageManifestFile"
          },
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/PackageManifestProvenance"
        },
        "schema_version": {
          "const": "package-manifest/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "candidate",
        "version",
        "files",
        "provenance"
      ],
      "title": "PackageManifest",
      "type": "object"
    },
    "PackageManifestFile": {
      "additionalProperties": false,
      "description": "One immutable file entry in a package manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/PackageFileRole"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "role"
      ],
      "title": "PackageManifestFile",
      "type": "object"
    },
    "PackageManifestProvenance": {
      "additionalProperties": false,
      "description": "Portable provenance references used to build a package manifest.",
      "properties": {
        "builder": {
          "minLength": 1,
          "title": "Builder",
          "type": "string"
        },
        "source": {
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source",
          "type": "array"
        }
      },
      "required": [
        "source",
        "builder"
      ],
      "title": "PackageManifestProvenance",
      "type": "object"
    },
    "PackageReceiptBlocker": {
      "additionalProperties": false,
      "description": "Stable typed blocker details for a package proof receipt.",
      "properties": {
        "code": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "PackageReceiptBlocker",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/package-archive-verification.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed proof that an immutable package archive matches its manifest.",
  "properties": {
    "archive_extracted": {
      "const": false,
      "default": false,
      "title": "Archive Extracted",
      "type": "boolean"
    },
    "archive_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archive Sha256"
    },
    "blocker": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackageReceiptBlocker"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackageManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mutation_performed": {
      "const": false,
      "default": false,
      "title": "Mutation Performed",
      "type": "boolean"
    },
    "network_used": {
      "const": false,
      "default": false,
      "title": "Network Used",
      "type": "boolean"
    },
    "package_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Digest"
    },
    "schema_version": {
      "const": "package-archive-verification/v1",
      "default": "package-archive-verification/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "verified_files": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
        "type": "string"
      },
      "title": "Verified Files",
      "type": "array"
    }
  },
  "required": [
    "status"
  ],
  "title": "PackageArchiveVerificationReceipt",
  "type": "object"
}
