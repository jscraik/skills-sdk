{
  "$defs": {
    "IntakeChecks": {
      "additionalProperties": false,
      "description": "Boolean proof lanes required before canonical admission.",
      "properties": {
        "identity": {
          "title": "Identity",
          "type": "boolean"
        },
        "owner_unchanged": {
          "title": "Owner Unchanged",
          "type": "boolean"
        },
        "provenance": {
          "title": "Provenance",
          "type": "boolean"
        },
        "rights": {
          "title": "Rights",
          "type": "boolean"
        }
      },
      "required": [
        "identity",
        "provenance",
        "rights",
        "owner_unchanged"
      ],
      "title": "IntakeChecks",
      "type": "object"
    },
    "IntakeDecision": {
      "additionalProperties": false,
      "description": "Candidate-bound admission result with typed, explicit blockers.",
      "properties": {
        "blocker_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Blocker Codes",
          "type": "array"
        },
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "checks": {
          "$ref": "#/$defs/IntakeChecks"
        },
        "decision": {
          "$ref": "#/$defs/IntakeDecisionStatus"
        },
        "schema_version": {
          "const": "intake-decision/v1",
          "default": "intake-decision/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "decision",
        "checks"
      ],
      "title": "IntakeDecision",
      "type": "object"
    },
    "IntakeDecisionStatus": {
      "description": "Explicit intake result with no implicit waiver path.",
      "enum": [
        "admit",
        "block",
        "reject",
        "needs_owner_decision"
      ],
      "title": "IntakeDecisionStatus",
      "type": "string"
    },
    "LocalCheckStage": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "intake",
            "validate",
            "scenario-quality",
            "scorer-quality",
            "scorer-calibration"
          ],
          "title": "Name",
          "type": "string"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillPackageIntakeReceipt"
            },
            {
              "$ref": "#/$defs/SkillPackageValidation"
            },
            {
              "$ref": "#/$defs/ScenarioQualityReceiptV2"
            },
            {
              "$ref": "#/$defs/ScorerQualityReceipt"
            },
            {
              "$ref": "#/$defs/ScorerCalibrationReceipt"
            }
          ],
          "title": "Receipt"
        }
      },
      "required": [
        "name",
        "receipt"
      ],
      "title": "LocalCheckStage",
      "type": "object"
    },
    "NormalizedPackage": {
      "additionalProperties": false,
      "description": "Portable normalized package before provider or runtime projection.",
      "properties": {
        "dependencies": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "identity": {
          "discriminator": {
            "mapping": {
              "plugin": "#/$defs/PluginIdentity",
              "skill": "#/$defs/SkillIdentity"
            },
            "propertyName": "package_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SkillIdentity"
            },
            {
              "$ref": "#/$defs/PluginIdentity"
            }
          ],
          "title": "Identity"
        },
        "lifecycle": {
          "$ref": "#/$defs/PackageLifecycleState",
          "default": "normalized"
        },
        "owner": {
          "$ref": "#/$defs/PackageOwner"
        },
        "package_type": {
          "$ref": "#/$defs/PackageType"
        },
        "schema_version": {
          "const": "normalized-package/v1",
          "default": "normalized-package/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PackageSource"
        }
      },
      "required": [
        "package_type",
        "identity",
        "source",
        "owner"
      ],
      "title": "NormalizedPackage",
      "type": "object"
    },
    "OwnershipState": {
      "description": "Ownership posture at intake; it is not a runtime state.",
      "enum": [
        "canonical",
        "transitional",
        "external"
      ],
      "title": "OwnershipState",
      "type": "string"
    },
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "PackageFileRole": {
      "description": "The portable role of a file included in a package manifest.",
      "enum": [
        "skill_md",
        "readme",
        "reference",
        "script",
        "asset",
        "eval"
      ],
      "title": "PackageFileRole",
      "type": "string"
    },
    "PackageLifecycleState": {
      "description": "Portable lifecycle state for a normalized package candidate.",
      "enum": [
        "discovered",
        "normalized",
        "admitted",
        "blocked",
        "retired"
      ],
      "title": "PackageLifecycleState",
      "type": "string"
    },
    "PackageManifestFile": {
      "additionalProperties": false,
      "description": "One immutable file entry in a package manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/PackageFileRole"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "role"
      ],
      "title": "PackageManifestFile",
      "type": "object"
    },
    "PackageOwner": {
      "additionalProperties": false,
      "description": "Canonical ownership and rights evidence for one package candidate.",
      "properties": {
        "maintainer": {
          "minLength": 1,
          "title": "Maintainer",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "ownership_state": {
          "$ref": "#/$defs/OwnershipState"
        },
        "rights": {
          "$ref": "#/$defs/RightsStatus"
        },
        "schema_version": {
          "const": "package-owner/v1",
          "default": "package-owner/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "maintainer",
        "ownership_state",
        "rights"
      ],
      "title": "PackageOwner",
      "type": "object"
    },
    "PackageReceiptBlocker": {
      "additionalProperties": false,
      "description": "Stable typed blocker details for a package proof receipt.",
      "properties": {
        "code": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "PackageReceiptBlocker",
      "type": "object"
    },
    "PackageSource": {
      "additionalProperties": false,
      "description": "Source identity preserved before a package is normalized.",
      "properties": {
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/SourceProvenance"
        },
        "schema_version": {
          "const": "package-source/v1",
          "default": "package-source/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/PackageSourceKind"
        }
      },
      "required": [
        "package_id",
        "provenance",
        "source_kind"
      ],
      "title": "PackageSource",
      "type": "object"
    },
    "PackageSourceKind": {
      "description": "How a package source was obtained before normalization.",
      "enum": [
        "git",
        "archive",
        "external",
        "local"
      ],
      "title": "PackageSourceKind",
      "type": "string"
    },
    "PackageType": {
      "description": "Canonical package categories admitted by the Foundry.",
      "enum": [
        "skill",
        "plugin"
      ],
      "title": "PackageType",
      "type": "string"
    },
    "PluginIdentity": {
      "additionalProperties": false,
      "description": "Agent Plugins identity, independent of a client adapter.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "package_type": {
          "const": "plugin",
          "default": "plugin",
          "title": "Package Type",
          "type": "string"
        },
        "schema_version": {
          "const": "plugin-identity/v1",
          "default": "plugin-identity/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "name",
        "version"
      ],
      "title": "PluginIdentity",
      "type": "object"
    },
    "RightsStatus": {
      "additionalProperties": false,
      "description": "Rights evidence required before canonical admission.",
      "properties": {
        "basis": {
          "enum": [
            "authored",
            "license",
            "permission"
          ],
          "title": "Basis",
          "type": "string"
        },
        "evidence_ref": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        }
      },
      "required": [
        "basis",
        "license",
        "evidence_ref"
      ],
      "title": "RightsStatus",
      "type": "object"
    },
    "ScenarioQualityAppliedPolicyV2": {
      "additionalProperties": false,
      "properties": {
        "maximum_release_cases": {
          "const": 10,
          "title": "Maximum Release Cases",
          "type": "integer"
        },
        "minimum_negative_or_edge": {
          "const": 1,
          "title": "Minimum Negative Or Edge",
          "type": "integer"
        },
        "minimum_pressure_or_regression": {
          "const": 1,
          "title": "Minimum Pressure Or Regression",
          "type": "integer"
        },
        "minimum_release_cases": {
          "const": 10,
          "title": "Minimum Release Cases",
          "type": "integer"
        },
        "target_release_cases": {
          "const": 10,
          "title": "Target Release Cases",
          "type": "integer"
        }
      },
      "required": [
        "minimum_release_cases",
        "target_release_cases",
        "maximum_release_cases",
        "minimum_pressure_or_regression",
        "minimum_negative_or_edge"
      ],
      "title": "ScenarioQualityAppliedPolicyV2",
      "type": "object"
    },
    "ScenarioQualityFinding": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "code": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ScenarioQualityFinding",
      "type": "object"
    },
    "ScenarioQualityReceiptV2": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageCandidateIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effective_policy": {
          "$ref": "#/$defs/ScenarioQualityAppliedPolicyV2"
        },
        "execution_performed": {
          "const": false,
          "default": false,
          "title": "Execution Performed",
          "type": "boolean"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScenarioQualityFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "mutation_performed": {
          "const": false,
          "default": false,
          "title": "Mutation Performed",
          "type": "boolean"
        },
        "negative_or_edge_count": {
          "default": 0,
          "minimum": 0,
          "title": "Negative Or Edge Count",
          "type": "integer"
        },
        "network_used": {
          "const": false,
          "default": false,
          "title": "Network Used",
          "type": "boolean"
        },
        "pressure_or_regression_count": {
          "default": 0,
          "minimum": 0,
          "title": "Pressure Or Regression Count",
          "type": "integer"
        },
        "scenario_count": {
          "minimum": 0,
          "title": "Scenario Count",
          "type": "integer"
        },
        "scenario_set_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Set Id"
        },
        "schema_version": {
          "const": "scenario-quality/v2",
          "default": "scenario-quality/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "enum": [
            "all",
            "release"
          ],
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "status",
        "scenario_count",
        "effective_policy"
      ],
      "title": "ScenarioQualityReceiptV2",
      "type": "object"
    },
    "ScorerCalibrationAppliedPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_false_negatives": {
          "minimum": 0,
          "title": "Max False Negatives",
          "type": "integer"
        },
        "max_false_positives": {
          "minimum": 0,
          "title": "Max False Positives",
          "type": "integer"
        },
        "minimum_examples": {
          "minimum": 1,
          "title": "Minimum Examples",
          "type": "integer"
        },
        "minimum_true_negatives": {
          "minimum": 1,
          "title": "Minimum True Negatives",
          "type": "integer"
        },
        "minimum_true_positives": {
          "minimum": 1,
          "title": "Minimum True Positives",
          "type": "integer"
        },
        "threshold": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "threshold",
        "minimum_examples",
        "minimum_true_positives",
        "minimum_true_negatives",
        "max_false_positives",
        "max_false_negatives"
      ],
      "title": "ScorerCalibrationAppliedPolicy",
      "type": "object"
    },
    "ScorerCalibrationMetrics": {
      "additionalProperties": false,
      "properties": {
        "fn": {
          "minimum": 0,
          "title": "Fn",
          "type": "integer"
        },
        "fp": {
          "minimum": 0,
          "title": "Fp",
          "type": "integer"
        },
        "tn": {
          "minimum": 0,
          "title": "Tn",
          "type": "integer"
        },
        "tp": {
          "minimum": 0,
          "title": "Tp",
          "type": "integer"
        }
      },
      "required": [
        "tp",
        "tn",
        "fp",
        "fn"
      ],
      "title": "ScorerCalibrationMetrics",
      "type": "object"
    },
    "ScorerCalibrationRates": {
      "additionalProperties": false,
      "properties": {
        "accuracy": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accuracy"
        },
        "precision": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision"
        },
        "tnr": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tnr"
        },
        "tpr": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tpr"
        }
      },
      "title": "ScorerCalibrationRates",
      "type": "object"
    },
    "ScorerCalibrationReceipt": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageCandidateIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confusion_matrix": {
          "$ref": "#/$defs/ScorerCalibrationMetrics"
        },
        "effective_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScorerCalibrationAppliedPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "example_count": {
          "default": 0,
          "minimum": 0,
          "title": "Example Count",
          "type": "integer"
        },
        "execution_performed": {
          "const": false,
          "default": false,
          "title": "Execution Performed",
          "type": "boolean"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScenarioQualityFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "metrics": {
          "$ref": "#/$defs/ScorerCalibrationRates"
        },
        "mutation_performed": {
          "const": false,
          "default": false,
          "title": "Mutation Performed",
          "type": "boolean"
        },
        "network_used": {
          "const": false,
          "default": false,
          "title": "Network Used",
          "type": "boolean"
        },
        "parameters": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScorerJudgeParameters"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prompt_version": {
          "default": "",
          "title": "Prompt Version",
          "type": "string"
        },
        "schema_version": {
          "const": "scorer-calibration/v1",
          "default": "scorer-calibration/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scorer_id": {
          "default": "",
          "title": "Scorer Id",
          "type": "string"
        },
        "scorer_version_or_digest": {
          "default": "",
          "title": "Scorer Version Or Digest",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "ScorerCalibrationReceipt",
      "type": "object"
    },
    "ScorerJudgeParameters": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "temperature": {
          "title": "Temperature",
          "type": "number"
        },
        "trial_count": {
          "minimum": 1,
          "title": "Trial Count",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "temperature",
        "trial_count"
      ],
      "title": "ScorerJudgeParameters",
      "type": "object"
    },
    "ScorerQualityReceipt": {
      "additionalProperties": false,
      "properties": {
        "calibration_probe_count": {
          "default": 0,
          "minimum": 0,
          "title": "Calibration Probe Count",
          "type": "integer"
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageCandidateIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_performed": {
          "const": false,
          "default": false,
          "title": "Execution Performed",
          "type": "boolean"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScenarioQualityFinding"
          },
          "title": "Findings",
          "type": "array"
        },
