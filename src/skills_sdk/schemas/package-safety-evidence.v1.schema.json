      "title": "Input Receipt Id",
      "type": "string"
    },
    "lane": {
      "const": "safety_review",
      "title": "Lane",
      "type": "string"
    },
    "mutation_performed": {
      "const": false,
      "default": false,
      "title": "Mutation Performed",
      "type": "boolean"
    },
