  "$id": "https://schemas.skills-sdk.dev/package-safety-evidence.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_reviewed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocker": {
            "type": "null"
          },
          "blockers": {
            "maxItems": 0
          },
          "evidence": {
            "maxItems": 0
          },
          "findings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "reviewed_no_issue"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocker": {
            "type": "null"
          },
          "blockers": {
            "maxItems": 0
          },
          "evidence": {
            "minItems": 1
          },
          "findings": {
            "maxItems": 0
          }
        },
        "required": [
          "evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "issue_found"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocker": {
            "$ref": "#/$defs/PackageSafetyBlocker"
          },
          "blockers": {
            "minItems": 1
          },
          "evidence": {
            "minItems": 1
          },
          "findings": {
            "contains": {
              "properties": {
                "severity": {
                  "enum": [
                    "warning",
                    "blocker"
                  ]
                }
              },
              "required": [
                "severity"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "evidence",
          "findings",
          "blocker",
          "blockers"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "metadata_insufficient"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocker": {
            "$ref": "#/$defs/PackageSafetyBlocker"
          },
          "blockers": {
            "minItems": 1
          },
          "findings": {
            "maxItems": 0
          }
        },
        "required": [
          "blocker",
          "blockers"
        ]
      }
    }
  ],
  "description": "One adapter-supplied package safety evidence state, never a safe boolean.",
  "properties": {
