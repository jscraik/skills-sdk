    },
    "rights_decision_performed": {
      "const": false,
      "default": false,
      "title": "Rights Decision Performed",
      "type": "boolean"
    },
    "schema_version": {
      "const": "package-safety-evidence/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
