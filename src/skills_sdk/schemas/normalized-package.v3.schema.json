{
  "$defs": {
    "ArchivePackageSource": {
      "additionalProperties": false,
      "description": "Represent archive acquisition without repository or remote identifiers.",
      "properties": {
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ArchiveSourceProvenance"
        },
        "schema_version": {
          "const": "archive-package-source/v1",
          "default": "archive-package-source/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "const": "archive",
          "default": "archive",
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "provenance"
      ],
      "title": "ArchivePackageSource",
      "type": "object"
    },
    "ArchiveSourceProvenance": {
      "additionalProperties": false,
      "description": "One child bound to a local archive snapshot, not a saved release.",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "archive-source-provenance/v1",
          "default": "archive-source-provenance/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/ArchiveSourceSnapshot"
        }
      },
      "required": [
        "snapshot",
        "path",
        "candidate"
      ],
      "title": "ArchiveSourceProvenance",
      "type": "object"
    },
    "ArchiveSourceSnapshot": {
      "additionalProperties": false,
      "description": "Local recovery binding, explicitly without upstream release identity.",
      "properties": {
        "acquisition": {
          "const": "user-supplied-recovery",
          "default": "user-supplied-recovery",
          "title": "Acquisition",
          "type": "string"
        },
        "archive_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Archive Sha256",
          "type": "string"
        },
        "binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "root_candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "root_mode_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root Mode Manifest Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "archive-source-snapshot/v1",
          "default": "archive-source-snapshot/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "upstream_release": {
          "default": null,
          "title": "Upstream Release",
          "type": "null"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,199}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "archive_sha256",
        "root_candidate",
        "root_mode_manifest_sha256",
        "binding_sha256"
      ],
      "title": "ArchiveSourceSnapshot",
      "type": "object"
    },
    "OwnershipState": {
      "description": "Ownership posture at intake; it is not a runtime state.",
      "enum": [
        "canonical",
        "transitional",
        "external"
      ],
      "title": "OwnershipState",
      "type": "string"
    },
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "PackageLifecycleState": {
      "description": "Portable lifecycle state for a normalized package candidate.",
      "enum": [
        "discovered",
        "normalized",
        "admitted",
        "blocked",
        "retired"
      ],
      "title": "PackageLifecycleState",
      "type": "string"
    },
    "PackageOwner": {
      "additionalProperties": false,
      "description": "Canonical ownership and rights evidence for one package candidate.",
      "properties": {
        "maintainer": {
          "minLength": 1,
          "title": "Maintainer",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "ownership_state": {
          "$ref": "#/$defs/OwnershipState"
        },
        "rights": {
          "$ref": "#/$defs/RightsStatus"
        },
        "schema_version": {
          "const": "package-owner/v1",
          "default": "package-owner/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "maintainer",
        "ownership_state",
        "rights"
      ],
      "title": "PackageOwner",
      "type": "object"
    },
    "PackageType": {
      "description": "Canonical package categories admitted by the Foundry.",
      "enum": [
        "skill",
        "plugin"
      ],
      "title": "PackageType",
      "type": "string"
    },
    "PluginIdentity": {
      "additionalProperties": false,
      "description": "Agent Plugins identity, independent of a client adapter.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "package_type": {
          "const": "plugin",
          "default": "plugin",
          "title": "Package Type",
          "type": "string"
        },
        "schema_version": {
          "const": "plugin-identity/v1",
          "default": "plugin-identity/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "name",
        "version"
      ],
      "title": "PluginIdentity",
      "type": "object"
    },
    "RightsStatus": {
      "additionalProperties": false,
      "description": "Rights evidence required before canonical admission.",
      "properties": {
        "basis": {
          "enum": [
            "authored",
            "license",
            "permission"
          ],
          "title": "Basis",
          "type": "string"
        },
        "evidence_ref": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        }
      },
      "required": [
        "basis",
        "license",
        "evidence_ref"
      ],
      "title": "RightsStatus",
      "type": "object"
    },
    "SkillIdentity": {
      "additionalProperties": false,
      "description": "Agent Skills identity, independent of runtime installation.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "package_type": {
          "const": "skill",
          "default": "skill",
          "title": "Package Type",
          "type": "string"
        },
        "schema_version": {
          "const": "skill-identity/v1",
          "default": "skill-identity/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "name",
        "version"
      ],
      "title": "SkillIdentity",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/normalized-package.v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "package_type": {
            "const": "skill"
          }
        },
        "required": [
          "package_type"
        ]
      },
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "package_type": {
                "const": "skill"
              }
            },
            "required": [
              "package_type"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "package_type": {
            "const": "plugin"
          }
        },
        "required": [
          "package_type"
        ]
      },
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "package_type": {
                "const": "plugin"
              }
            },
            "required": [
              "package_type"
            ]
          }
        }
      }
    }
  ],
  "description": "Archive-backed normalization with unchanged admission semantics.",
  "properties": {
    "dependencies": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "identity": {
      "discriminator": {
        "mapping": {
          "plugin": "#/$defs/PluginIdentity",
          "skill": "#/$defs/SkillIdentity"
        },
        "propertyName": "package_type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SkillIdentity"
        },
        {
          "$ref": "#/$defs/PluginIdentity"
        }
      ],
      "title": "Identity"
    },
    "lifecycle": {
      "$ref": "#/$defs/PackageLifecycleState",
      "default": "normalized"
    },
    "owner": {
      "$ref": "#/$defs/PackageOwner"
    },
    "package_type": {
      "$ref": "#/$defs/PackageType"
    },
    "schema_version": {
      "const": "normalized-package/v3",
      "default": "normalized-package/v3",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ArchivePackageSource"
    }
  },
  "required": [
    "package_type",
    "identity",
    "source",
    "owner"
  ],
  "title": "NormalizedPackageV3",
  "type": "object",
  "x-skills-sdk-semantic-validation": {
    "entrypoint": "skills_sdk.core.schema_registry.SchemaRegistry.validate",
    "required_for": [
      "saved descriptor fingerprint, root, mode, revision and selected-child bindings",
      "ordered quality receipts and unchanged source captures",
      "admission decisions preserve supplied checks without authenticating provenance"
    ]
  }
}
