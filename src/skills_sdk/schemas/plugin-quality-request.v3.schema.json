{
  "$defs": {
    "ArchiveSourceProvenance": {
      "additionalProperties": false,
      "description": "One child bound to a local archive snapshot, not a saved release.",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?![\\s\\S]*(?:[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890-\\u0891\\u08e2\\u180e\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ufeff\\ufff9-\\ufffb]|\ud804\udcbd|\ud804\udccd|\ud80d\udc30|\ud80d\udc31|\ud80d\udc32|\ud80d\udc33|\ud80d\udc34|\ud80d\udc35|\ud80d\udc36|\ud80d\udc37|\ud80d\udc38|\ud80d\udc39|\ud80d\udc3a|\ud80d\udc3b|\ud80d\udc3c|\ud80d\udc3d|\ud80d\udc3e|\ud80d\udc3f|\ud82f\udca0|\ud82f\udca1|\ud82f\udca2|\ud82f\udca3|\ud834\udd73|\ud834\udd74|\ud834\udd75|\ud834\udd76|\ud834\udd77|\ud834\udd78|\ud834\udd79|\ud834\udd7a|\udb40\udc01|\udb40\udc20|\udb40\udc21|\udb40\udc22|\udb40\udc23|\udb40\udc24|\udb40\udc25|\udb40\udc26|\udb40\udc27|\udb40\udc28|\udb40\udc29|\udb40\udc2a|\udb40\udc2b|\udb40\udc2c|\udb40\udc2d|\udb40\udc2e|\udb40\udc2f|\udb40\udc30|\udb40\udc31|\udb40\udc32|\udb40\udc33|\udb40\udc34|\udb40\udc35|\udb40\udc36|\udb40\udc37|\udb40\udc38|\udb40\udc39|\udb40\udc3a|\udb40\udc3b|\udb40\udc3c|\udb40\udc3d|\udb40\udc3e|\udb40\udc3f|\udb40\udc40|\udb40\udc41|\udb40\udc42|\udb40\udc43|\udb40\udc44|\udb40\udc45|\udb40\udc46|\udb40\udc47|\udb40\udc48|\udb40\udc49|\udb40\udc4a|\udb40\udc4b|\udb40\udc4c|\udb40\udc4d|\udb40\udc4e|\udb40\udc4f|\udb40\udc50|\udb40\udc51|\udb40\udc52|\udb40\udc53|\udb40\udc54|\udb40\udc55|\udb40\udc56|\udb40\udc57|\udb40\udc58|\udb40\udc59|\udb40\udc5a|\udb40\udc5b|\udb40\udc5c|\udb40\udc5d|\udb40\udc5e|\udb40\udc5f|\udb40\udc60|\udb40\udc61|\udb40\udc62|\udb40\udc63|\udb40\udc64|\udb40\udc65|\udb40\udc66|\udb40\udc67|\udb40\udc68|\udb40\udc69|\udb40\udc6a|\udb40\udc6b|\udb40\udc6c|\udb40\udc6d|\udb40\udc6e|\udb40\udc6f|\udb40\udc70|\udb40\udc71|\udb40\udc72|\udb40\udc73|\udb40\udc74|\udb40\udc75|\udb40\udc76|\udb40\udc77|\udb40\udc78|\udb40\udc79|\udb40\udc7a|\udb40\udc7b|\udb40\udc7c|\udb40\udc7d|\udb40\udc7e|\udb40\udc7f))(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "archive-source-provenance/v1",
          "default": "archive-source-provenance/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/ArchiveSourceSnapshot"
        }
      },
      "required": [
        "snapshot",
        "path",
        "candidate"
      ],
      "title": "ArchiveSourceProvenance",
      "type": "object"
    },
    "ArchiveSourceSnapshot": {
      "additionalProperties": false,
      "description": "Local recovery binding, explicitly without upstream release identity.",
      "properties": {
        "acquisition": {
          "const": "user-supplied-recovery",
          "default": "user-supplied-recovery",
          "title": "Acquisition",
          "type": "string"
        },
        "archive_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Archive Sha256",
          "type": "string"
        },
        "binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "root_candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "root_mode_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root Mode Manifest Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "archive-source-snapshot/v1",
          "default": "archive-source-snapshot/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "upstream_release": {
          "default": null,
          "title": "Upstream Release",
          "type": "null"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,199}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "archive_sha256",
        "root_candidate",
        "root_mode_manifest_sha256",
        "binding_sha256"
      ],
      "title": "ArchiveSourceSnapshot",
      "type": "object"
    },
    "ClaimCoverage": {
      "additionalProperties": false,
      "properties": {
        "case_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Case Ids",
          "type": "array"
        },
        "claim_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Claim Id",
          "type": "string"
        },
        "gap_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Gap Ids",
          "type": "array"
        }
      },
      "required": [
        "claim_id"
      ],
      "title": "ClaimCoverage",
      "type": "object"
    },
    "CoverageClaim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement"
      ],
      "title": "CoverageClaim",
      "type": "object"
    },
    "CoverageGap": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason",
        "owner"
      ],
      "title": "CoverageGap",
      "type": "object"
    },
    "IntakeChecks": {
      "additionalProperties": false,
      "description": "Boolean proof lanes required before canonical admission.",
      "properties": {
        "identity": {
          "title": "Identity",
          "type": "boolean"
        },
        "owner_unchanged": {
          "title": "Owner Unchanged",
          "type": "boolean"
        },
        "provenance": {
          "title": "Provenance",
          "type": "boolean"
        },
        "rights": {
          "title": "Rights",
          "type": "boolean"
        }
      },
      "required": [
        "identity",
        "provenance",
        "rights",
        "owner_unchanged"
      ],
      "title": "IntakeChecks",
      "type": "object"
    },
    "LocalCheckRequestV4": {
      "$comment": "Candidate equality and update lineage require the model or SchemaRegistry semantic validator.",
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "update_baseline": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "intent": {
                "const": "update"
              }
            },
            "required": [
              "intent"
            ]
          },
          "then": {
            "properties": {
              "update_baseline": {
                "type": "object"
              }
            },
            "required": [
              "update_baseline"
            ]
          }
        }
      ],
      "description": "Archive-backed external check, preserving old request source boundaries.",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "content_review_mode": {
          "enum": [
            "supplied",
            "observed"
          ],
          "title": "Content Review Mode",
          "type": "string"
        },
        "coverage_plan": {
          "$ref": "#/$defs/ScenarioCoveragePlan"
        },
        "intake": {
          "$ref": "#/$defs/SkillPackageIntakeContextV3"
        },
        "intent": {
          "enum": [
            "create",
            "update",
            "external-check"
          ],
          "title": "Intent",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/LocalQualityPolicy"
        },
        "schema_version": {
          "const": "local-check-request/v4",
          "default": "local-check-request/v4",
          "title": "Schema Version",
          "type": "string"
        },
        "update_baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageCandidateIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "intent",
        "candidate",
        "intake",
        "policy",
        "coverage_plan",
        "content_review_mode"
      ],
      "title": "LocalCheckRequestV4",
      "type": "object"
    },
    "LocalQualityPolicy": {
      "additionalProperties": false,
      "description": "Persist selected deterministic checks without asserting that they ran.",
      "properties": {
        "check_reference_content": {
          "default": false,
          "title": "Check Reference Content",
          "type": "boolean"
        },
        "max_entrypoint_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Entrypoint Lines"
        },
        "max_reference_depth": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Reference Depth"
        },
        "required_files": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?![\\s\\S]*(?:[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890-\\u0891\\u08e2\\u180e\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ufeff\\ufff9-\\ufffb]|\ud804\udcbd|\ud804\udccd|\ud80d\udc30|\ud80d\udc31|\ud80d\udc32|\ud80d\udc33|\ud80d\udc34|\ud80d\udc35|\ud80d\udc36|\ud80d\udc37|\ud80d\udc38|\ud80d\udc39|\ud80d\udc3a|\ud80d\udc3b|\ud80d\udc3c|\ud80d\udc3d|\ud80d\udc3e|\ud80d\udc3f|\ud82f\udca0|\ud82f\udca1|\ud82f\udca2|\ud82f\udca3|\ud834\udd73|\ud834\udd74|\ud834\udd75|\ud834\udd76|\ud834\udd77|\ud834\udd78|\ud834\udd79|\ud834\udd7a|\udb40\udc01|\udb40\udc20|\udb40\udc21|\udb40\udc22|\udb40\udc23|\udb40\udc24|\udb40\udc25|\udb40\udc26|\udb40\udc27|\udb40\udc28|\udb40\udc29|\udb40\udc2a|\udb40\udc2b|\udb40\udc2c|\udb40\udc2d|\udb40\udc2e|\udb40\udc2f|\udb40\udc30|\udb40\udc31|\udb40\udc32|\udb40\udc33|\udb40\udc34|\udb40\udc35|\udb40\udc36|\udb40\udc37|\udb40\udc38|\udb40\udc39|\udb40\udc3a|\udb40\udc3b|\udb40\udc3c|\udb40\udc3d|\udb40\udc3e|\udb40\udc3f|\udb40\udc40|\udb40\udc41|\udb40\udc42|\udb40\udc43|\udb40\udc44|\udb40\udc45|\udb40\udc46|\udb40\udc47|\udb40\udc48|\udb40\udc49|\udb40\udc4a|\udb40\udc4b|\udb40\udc4c|\udb40\udc4d|\udb40\udc4e|\udb40\udc4f|\udb40\udc50|\udb40\udc51|\udb40\udc52|\udb40\udc53|\udb40\udc54|\udb40\udc55|\udb40\udc56|\udb40\udc57|\udb40\udc58|\udb40\udc59|\udb40\udc5a|\udb40\udc5b|\udb40\udc5c|\udb40\udc5d|\udb40\udc5e|\udb40\udc5f|\udb40\udc60|\udb40\udc61|\udb40\udc62|\udb40\udc63|\udb40\udc64|\udb40\udc65|\udb40\udc66|\udb40\udc67|\udb40\udc68|\udb40\udc69|\udb40\udc6a|\udb40\udc6b|\udb40\udc6c|\udb40\udc6d|\udb40\udc6e|\udb40\udc6f|\udb40\udc70|\udb40\udc71|\udb40\udc72|\udb40\udc73|\udb40\udc74|\udb40\udc75|\udb40\udc76|\udb40\udc77|\udb40\udc78|\udb40\udc79|\udb40\udc7a|\udb40\udc7b|\udb40\udc7c|\udb40\udc7d|\udb40\udc7e|\udb40\udc7f))(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Required Files",
          "type": "array",
          "uniqueItems": true
        }
      },
      "title": "LocalQualityPolicy",
      "type": "object"
    },
    "OwnershipState": {
      "description": "Ownership posture at intake; it is not a runtime state.",
      "enum": [
        "canonical",
        "transitional",
        "external"
      ],
      "title": "OwnershipState",
      "type": "string"
    },
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "PackageOwner": {
      "additionalProperties": false,
      "description": "Canonical ownership and rights evidence for one package candidate.",
      "properties": {
        "maintainer": {
          "minLength": 1,
          "title": "Maintainer",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "ownership_state": {
          "$ref": "#/$defs/OwnershipState"
        },
        "rights": {
          "$ref": "#/$defs/RightsStatus"
        },
        "schema_version": {
          "const": "package-owner/v1",
          "default": "package-owner/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "maintainer",
        "ownership_state",
        "rights"
      ],
      "title": "PackageOwner",
      "type": "object"
    },
    "PluginQualityChildV3": {
      "additionalProperties": false,
      "description": "An archive-backed child selected from the containing plugin.",
      "properties": {
        "path": {
          "allOf": [
            {
              "pattern": "^skills/[^/]+$"
            }
          ],
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?![\\s\\S]*(?:[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890-\\u0891\\u08e2\\u180e\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ufeff\\ufff9-\\ufffb]|\ud804\udcbd|\ud804\udccd|\ud80d\udc30|\ud80d\udc31|\ud80d\udc32|\ud80d\udc33|\ud80d\udc34|\ud80d\udc35|\ud80d\udc36|\ud80d\udc37|\ud80d\udc38|\ud80d\udc39|\ud80d\udc3a|\ud80d\udc3b|\ud80d\udc3c|\ud80d\udc3d|\ud80d\udc3e|\ud80d\udc3f|\ud82f\udca0|\ud82f\udca1|\ud82f\udca2|\ud82f\udca3|\ud834\udd73|\ud834\udd74|\ud834\udd75|\ud834\udd76|\ud834\udd77|\ud834\udd78|\ud834\udd79|\ud834\udd7a|\udb40\udc01|\udb40\udc20|\udb40\udc21|\udb40\udc22|\udb40\udc23|\udb40\udc24|\udb40\udc25|\udb40\udc26|\udb40\udc27|\udb40\udc28|\udb40\udc29|\udb40\udc2a|\udb40\udc2b|\udb40\udc2c|\udb40\udc2d|\udb40\udc2e|\udb40\udc2f|\udb40\udc30|\udb40\udc31|\udb40\udc32|\udb40\udc33|\udb40\udc34|\udb40\udc35|\udb40\udc36|\udb40\udc37|\udb40\udc38|\udb40\udc39|\udb40\udc3a|\udb40\udc3b|\udb40\udc3c|\udb40\udc3d|\udb40\udc3e|\udb40\udc3f|\udb40\udc40|\udb40\udc41|\udb40\udc42|\udb40\udc43|\udb40\udc44|\udb40\udc45|\udb40\udc46|\udb40\udc47|\udb40\udc48|\udb40\udc49|\udb40\udc4a|\udb40\udc4b|\udb40\udc4c|\udb40\udc4d|\udb40\udc4e|\udb40\udc4f|\udb40\udc50|\udb40\udc51|\udb40\udc52|\udb40\udc53|\udb40\udc54|\udb40\udc55|\udb40\udc56|\udb40\udc57|\udb40\udc58|\udb40\udc59|\udb40\udc5a|\udb40\udc5b|\udb40\udc5c|\udb40\udc5d|\udb40\udc5e|\udb40\udc5f|\udb40\udc60|\udb40\udc61|\udb40\udc62|\udb40\udc63|\udb40\udc64|\udb40\udc65|\udb40\udc66|\udb40\udc67|\udb40\udc68|\udb40\udc69|\udb40\udc6a|\udb40\udc6b|\udb40\udc6c|\udb40\udc6d|\udb40\udc6e|\udb40\udc6f|\udb40\udc70|\udb40\udc71|\udb40\udc72|\udb40\udc73|\udb40\udc74|\udb40\udc75|\udb40\udc76|\udb40\udc77|\udb40\udc78|\udb40\udc79|\udb40\udc7a|\udb40\udc7b|\udb40\udc7c|\udb40\udc7d|\udb40\udc7e|\udb40\udc7f))(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Path",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/LocalCheckRequestV4"
        }
      },
      "required": [
        "path",
        "request"
      ],
      "title": "PluginQualityChildV3",
      "type": "object"
    },
    "RightsStatus": {
      "additionalProperties": false,
      "description": "Rights evidence required before canonical admission.",
      "properties": {
        "basis": {
          "enum": [
            "authored",
            "license",
            "permission"
          ],
          "title": "Basis",
          "type": "string"
        },
