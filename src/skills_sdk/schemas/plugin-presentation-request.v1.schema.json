{
  "$defs": {
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "PluginImageApproval": {
      "additionalProperties": false,
      "description": "Public-safe supplied approval for one exact candidate image.",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "distinctive": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distinctive"
        },
        "evidence_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "image_path": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Image Path",
          "type": "string"
        },
        "image_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "icon",
            "screenshot"
          ],
          "title": "Kind",
          "type": "string"
        },
        "light_dark": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Light Dark"
        },
        "professional": {
          "const": true,
          "title": "Professional",
          "type": "boolean"
        },
        "recognisable": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recognisable"
        },
        "rights_confirmed": {
          "const": true,
          "title": "Rights Confirmed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "plugin-image-approval/v1",
          "default": "plugin-image-approval/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "small_size": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Small Size"
        }
      },
      "required": [
        "candidate",
        "image_path",
        "image_sha256",
        "kind",
        "professional",
        "rights_confirmed",
        "evidence_ref",
        "evidence_sha256"
      ],
      "title": "PluginImageApproval",
      "type": "object"
    },
    "PluginPresentationCopyApproval": {
      "additionalProperties": false,
      "description": "Supplied copy-accuracy assertion for the exact selected settings object.",
      "properties": {
        "accurate": {
          "const": true,
          "title": "Accurate",
          "type": "boolean"
        },
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "evidence_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "openai_settings_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Openai Settings Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "plugin-presentation-copy-approval/v1",
          "default": "plugin-presentation-copy-approval/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "openai_settings_sha256",
        "accurate",
        "evidence_ref",
        "evidence_sha256"
      ],
      "title": "PluginPresentationCopyApproval",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/plugin-presentation-request.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Caller expectations and approvals for one fresh presentation assessment.",
  "properties": {
    "candidate": {
      "$ref": "#/$defs/PackageCandidateIdentity"
    },
    "copy_approval": {
      "$ref": "#/$defs/PluginPresentationCopyApproval"
    },
    "image_approvals": {
      "items": {
        "$ref": "#/$defs/PluginImageApproval"
      },
      "maxItems": 64,
      "title": "Image Approvals",
      "type": "array"
    },
    "mode_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Mode Manifest Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "plugin-presentation-request/v1",
      "default": "plugin-presentation-request/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "candidate",
    "mode_manifest_sha256",
    "image_approvals",
    "copy_approval"
  ],
  "title": "PluginPresentationRequest",
  "type": "object"
}
