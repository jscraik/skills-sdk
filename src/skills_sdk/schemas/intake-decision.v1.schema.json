{
  "$defs": {
    "IntakeChecks": {
      "additionalProperties": false,
      "description": "Boolean proof lanes required before canonical admission.",
      "properties": {
        "identity": {
          "title": "Identity",
          "type": "boolean"
        },
        "owner_unchanged": {
          "title": "Owner Unchanged",
          "type": "boolean"
        },
        "provenance": {
          "title": "Provenance",
          "type": "boolean"
        },
        "rights": {
          "title": "Rights",
          "type": "boolean"
        }
      },
      "required": [
        "identity",
        "provenance",
        "rights",
        "owner_unchanged"
      ],
      "title": "IntakeChecks",
      "type": "object"
    },
    "IntakeDecisionStatus": {
      "description": "Explicit intake result with no implicit waiver path.",
      "enum": [
        "admit",
        "block",
        "reject",
        "needs_owner_decision"
      ],
      "title": "IntakeDecisionStatus",
      "type": "string"
    },
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/intake-decision.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Candidate-bound admission result with typed, explicit blockers.",
  "properties": {
    "blocker_codes": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Blocker Codes",
      "type": "array"
    },
    "candidate": {
      "$ref": "#/$defs/PackageCandidateIdentity"
    },
    "checks": {
      "$ref": "#/$defs/IntakeChecks"
    },
    "decision": {
      "$ref": "#/$defs/IntakeDecisionStatus"
    },
    "schema_version": {
      "const": "intake-decision/v1",
      "default": "intake-decision/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "candidate",
    "decision",
    "checks"
  ],
  "title": "IntakeDecision",
  "type": "object"
}
