{
  "$defs": {
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "PackageFileRole": {
      "description": "The portable role of a file included in a package manifest.",
      "enum": [
        "skill_md",
        "readme",
        "reference",
        "script",
        "asset",
        "eval"
      ],
      "title": "PackageFileRole",
      "type": "string"
    },
    "PackageManifestFile": {
      "additionalProperties": false,
      "description": "One immutable file entry in a package manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/PackageFileRole"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "role"
      ],
      "title": "PackageManifestFile",
      "type": "object"
    },
    "PluginBuildReceipt": {
      "additionalProperties": false,
      "description": "Deterministic build over a complete capture, including its permission ledger.",
      "properties": {
        "archive_emitted": {
          "const": false,
          "default": false,
          "title": "Archive Emitted",
          "type": "boolean"
        },
        "build_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Digest"
        },
        "execution_authorized": {
          "const": false,
          "default": false,
          "title": "Execution Authorized",
          "type": "boolean"
        },
        "mutation_performed": {
          "const": false,
          "default": false,
          "title": "Mutation Performed",
          "type": "boolean"
        },
        "publication_performed": {
          "const": false,
          "default": false,
          "title": "Publication Performed",
          "type": "boolean"
        },
        "release_ready": {
          "const": false,
          "default": false,
          "title": "Release Ready",
          "type": "boolean"
        },
        "schema_version": {
          "const": "plugin-build/v1",
          "default": "plugin-build/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "built",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/PluginPackageValidation"
        }
      },
      "required": [
        "status",
        "validation"
      ],
      "title": "PluginBuildReceipt",
      "type": "object"
    },
    "PluginCapturedFile": {
      "additionalProperties": false,
      "description": "Captured bytes plus ordinary permissions; no new legacy file role.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Path",
          "type": "string"
        },
        "permission_mode": {
          "maximum": 511,
          "minimum": 0,
          "title": "Permission Mode",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 16777216,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "permission_mode"
      ],
      "title": "PluginCapturedFile",
      "type": "object"
    },
    "PluginHardeningPolicy": {
      "additionalProperties": false,
      "description": "Local structural budgets; presentation approval remains a separate supplied assertion.",
      "properties": {
        "max_file_count": {
          "default": 1024,
          "maximum": 1024,
          "minimum": 1,
          "title": "Max File Count",
          "type": "integer"
        },
        "max_total_bytes": {
          "default": 67108864,
          "maximum": 67108864,
          "minimum": 1,
          "title": "Max Total Bytes",
          "type": "integer"
        },
        "require_readme": {
          "default": true,
          "title": "Require Readme",
          "type": "boolean"
        }
      },
      "title": "PluginHardeningPolicy",
      "type": "object"
    },
    "PluginImageApproval": {
      "additionalProperties": false,
      "description": "Public-safe supplied approval for one exact candidate image.",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "distinctive": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distinctive"
        },
        "evidence_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "image_path": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Image Path",
          "type": "string"
        },
        "image_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "icon",
            "screenshot"
          ],
          "title": "Kind",
          "type": "string"
        },
        "light_dark": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Light Dark"
        },
        "professional": {
          "const": true,
          "title": "Professional",
          "type": "boolean"
        },
        "recognisable": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recognisable"
        },
        "rights_confirmed": {
          "const": true,
          "title": "Rights Confirmed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "plugin-image-approval/v1",
          "default": "plugin-image-approval/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "small_size": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Small Size"
        }
      },
      "required": [
        "candidate",
        "image_path",
        "image_sha256",
        "kind",
        "professional",
        "rights_confirmed",
        "evidence_ref",
        "evidence_sha256"
      ],
      "title": "PluginImageApproval",
      "type": "object"
    },
    "PluginPackageValidation": {
      "additionalProperties": false,
      "description": "Whole-plugin structural proof, with no execution or release authority.",
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageCandidateIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_authorized": {
          "const": false,
          "default": false,
          "title": "Execution Authorized",
          "type": "boolean"
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginCapturedFile"
          },
          "maxItems": 1024,
          "title": "Files",
          "type": "array"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SkillPackageFinding"
          },
          "maxItems": 2048,
          "title": "Findings",
          "type": "array"
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/PortablePluginManifest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode Manifest Sha256"
        },
        "mutation_performed": {
          "const": false,
          "default": false,
          "title": "Mutation Performed",
          "type": "boolean"
        },
        "policy": {
          "$ref": "#/$defs/PluginValidationPolicy",
          "default": {
            "require_description": false,
            "require_version": false
          }
        },
        "release_ready": {
          "const": false,
          "default": false,
          "title": "Release Ready",
          "type": "boolean"
        },
        "schema_version": {
          "const": "plugin-package-validation/v1",
          "default": "plugin-package-validation/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "skills": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginSkillBinding"
          },
          "maxItems": 128,
          "title": "Skills",
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "PluginPackageValidation",
      "type": "object"
    },
    "PluginPresentationCheck": {
      "additionalProperties": false,
      "description": "Offline assessment of supplied assertions and freshly captured image bytes.",
      "properties": {
        "archive_verified": {
          "const": false,
          "default": false,
          "title": "Archive Verified",
          "type": "boolean"
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageCandidateIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "copy_approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginPresentationCopyApproval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_authorized": {
          "const": false,
          "default": false,
          "title": "Execution Authorized",
          "type": "boolean"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SkillPackageFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "host_display_observed": {
          "const": false,
          "default": false,
          "title": "Host Display Observed",
          "type": "boolean"
        },
        "images": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginPresentationImage"
          },
          "maxItems": 64,
          "title": "Images",
          "type": "array"
        },
        "mode_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode Manifest Sha256"
        },
        "mutation_performed": {
          "const": false,
          "default": false,
          "title": "Mutation Performed",
          "type": "boolean"
        },
        "openai_settings_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openai Settings Sha256"
        },
        "openai_settings_source": {
          "default": "none",
          "enum": [
            "none",
            "inline",
            "compatibility"
          ],
          "title": "Openai Settings Source",
          "type": "string"
        },
        "profile": {
          "const": "openai-icons-2026-10-08/v1",
          "default": "openai-icons-2026-10-08/v1",
          "title": "Profile",
          "type": "string"
        },
        "publication_verified": {
          "const": false,
          "default": false,
          "title": "Publication Verified",
          "type": "boolean"
        },
        "release_ready": {
          "const": false,
          "default": false,
          "title": "Release Ready",
          "type": "boolean"
        },
        "schema_version": {
          "const": "plugin-presentation-check/v1",
          "default": "plugin-presentation-check/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "PluginPresentationCheck",
      "type": "object"
    },
    "PluginPresentationCopyApproval": {
      "additionalProperties": false,
      "description": "Supplied copy-accuracy assertion for the exact selected settings object.",
      "properties": {
        "accurate": {
          "const": true,
          "title": "Accurate",
          "type": "boolean"
        },
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "evidence_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "openai_settings_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Openai Settings Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "plugin-presentation-copy-approval/v1",
          "default": "plugin-presentation-copy-approval/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "openai_settings_sha256",
        "accurate",
        "evidence_ref",
        "evidence_sha256"
      ],
      "title": "PluginPresentationCopyApproval",
      "type": "object"
    },
    "PluginPresentationImage": {
      "additionalProperties": false,
      "description": "Decoded facts and supplied approval for one captured presentation image.",
      "properties": {
        "approval": {
          "$ref": "#/$defs/PluginImageApproval"
        },
        "format": {
          "enum": [
            "png",
            "jpeg",
            "webp",
            "svg"
          ],
          "title": "Format",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Path",
          "type": "string"
        },
        "roles": {
          "items": {
            "enum": [
              "logo",
              "composerIcon",
              "logoDark",
              "composerIconDark",
              "screenshot"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 5242880,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "format",
        "width",
        "height",
        "roles",
        "approval"
      ],
      "title": "PluginPresentationImage",
      "type": "object"
    },
    "PluginSkillBinding": {
      "additionalProperties": false,
      "description": "The existing standalone validator result for one direct skill subtree.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Path",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/SkillPackageValidation"
        }
      },
      "required": [
        "path",
        "validation"
      ],
      "title": "PluginSkillBinding",
      "type": "object"
    },
    "PluginValidationPolicy": {
      "additionalProperties": false,
      "description": "Opt-in SDK metadata policy, separate from portable base conformance.",
      "properties": {
        "require_description": {
          "default": false,
          "title": "Require Description",
          "type": "boolean"
        },
        "require_version": {
          "default": false,
          "title": "Require Version",
          "type": "boolean"
        }
      },
      "title": "PluginValidationPolicy",
      "type": "object"
    },
    "PortablePluginManifest": {
      "additionalProperties": false,
      "description": "Bounded projection of root metadata; optional base fields stay optional.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "manifest_schema_uri": {
          "const": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
          "default": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
          "title": "Manifest Schema Uri",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "openai_settings_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openai Settings Sha256"
        },
        "openai_settings_source": {
          "default": "none",
          "enum": [
            "inline",
            "compatibility",
            "none"
          ],
          "title": "Openai Settings Source",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name",
        "source_sha256"
      ],
      "title": "PortablePluginManifest",
      "type": "object"
    },
    "SkillIdentity": {
      "additionalProperties": false,
      "description": "Agent Skills identity, independent of runtime installation.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "package_type": {
          "const": "skill",
          "default": "skill",
          "title": "Package Type",
          "type": "string"
        },
        "schema_version": {
          "const": "skill-identity/v1",
          "default": "skill-identity/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "name",
        "version"
      ],
      "title": "SkillIdentity",
      "type": "object"
    },
    "SkillPackageFinding": {
      "additionalProperties": false,
      "description": "One stable, evidence-bound standalone-skill finding.",
      "properties": {
        "code": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/ValidationSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "SkillPackageFinding",
      "type": "object"
    },
    "SkillPackageValidation": {
      "additionalProperties": false,
      "description": "Read-only structural result for one standalone skill candidate.",
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageCandidateIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageManifestFile"
          },
          "title": "Files",
          "type": "array"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SkillPackageFinding"
          },
          "title": "Findings",
