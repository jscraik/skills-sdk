      },
      "required": [
        "code",
        "message"
      ],
      "title": "PackageSafetyBlocker",
      "type": "object"
    },
    "PackageSafetyEvidenceReceipt": {
      "additionalProperties": false,
      "description": "One adapter-supplied package safety evidence state, never a safe boolean.",
      "properties": {
        "admission_performed": {
          "const": false,
          "default": false,
          "title": "Admission Performed",
          "type": "boolean"
        },
        "blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageSafetyBlocker"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "blockers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageSafetyBlocker"
          },
          "title": "Blockers",
          "type": "array"
        },
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageSafetyEvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageSafetyFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "input_receipt_id": {
          "not": {
