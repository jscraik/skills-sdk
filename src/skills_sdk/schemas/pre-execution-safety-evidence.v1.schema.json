      "title": "PackageSafetyReviewer",
      "type": "object"
    },
    "SecurityFinding": {
      "additionalProperties": false,
      "description": "Redacted finding metadata; raw secret values never enter the contract.",
      "properties": {
        "category": {
          "enum": [
            "secret",
            "unsafe_path",
            "external_service",
            "license",
            "mcp_auth",
            "dependency"
          ],
          "title": "Category",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "blocker"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "category",
        "severity",
        "message",
        "evidence_refs"
      ],
      "title": "SecurityFinding",
      "type": "object"
    },
    "SecurityScreeningResult": {
      "additionalProperties": false,
      "description": "Candidate-bound secret and unsafe-package screening result.",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SecurityFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "mutation_performed": {
          "const": false,
          "default": false,
          "title": "Mutation Performed",
          "type": "boolean"
        },
        "scanned_paths": {
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Scanned Paths",
          "type": "array"
        },
        "schema_version": {
          "const": "security-screening/v1",
          "default": "security-screening/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sensor_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Sensor Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "needs_review",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "sensor_ids",
        "status",
        "scanned_paths"
      ],
      "title": "SecurityScreeningResult",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/pre-execution-safety-evidence.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Actual upstream and review artifacts, never an ID-only admission flag.",
  "properties": {
    "checklist": {
      "items": {
        "$ref": "#/$defs/CapabilitySafetyReview"
      },
      "title": "Checklist",
      "type": "array"
    },
    "checklist_version": {
      "const": "sdk-capability-checklist/v1",
      "default": "sdk-capability-checklist/v1",
      "title": "Checklist Version",
      "type": "string"
    },
    "package_receipt": {
      "$ref": "#/$defs/PackageReceiptV2"
    },
    "safety_receipt": {
      "$ref": "#/$defs/PackageSafetyEvidenceReceipt"
    },
    "schema_version": {
      "const": "pre-execution-safety-evidence/v1",
      "default": "pre-execution-safety-evidence/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "screening": {
      "$ref": "#/$defs/SecurityScreeningResult"
    }
  },
  "required": [
    "package_receipt",
    "safety_receipt",
    "screening",
    "checklist"
  ],
  "title": "PreExecutionSafetyEvidence",
  "type": "object"
}
