    "judge_result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Judge Result Sha256",
      "type": "string"
    },
    "mutation_performed": {
      "const": false,
      "default": false,
      "title": "Mutation Performed",
      "type": "boolean"
    },
    "output_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Sha256",
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/ProviderIdentityV2"
    },
    "raw_output_included": {
      "const": false,
      "default": false,
      "title": "Raw Output Included",
      "type": "boolean"
