{
  "$defs": {
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/archive-source-snapshot.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Local recovery binding, explicitly without upstream release identity.",
  "properties": {
    "acquisition": {
      "const": "user-supplied-recovery",
      "default": "user-supplied-recovery",
      "title": "Acquisition",
      "type": "string"
    },
    "archive_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Archive Sha256",
      "type": "string"
    },
    "binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Binding Sha256",
      "type": "string"
    },
    "root_candidate": {
      "$ref": "#/$defs/PackageCandidateIdentity"
    },
    "root_mode_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Root Mode Manifest Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "archive-source-snapshot/v1",
      "default": "archive-source-snapshot/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "upstream_release": {
      "default": null,
      "title": "Upstream Release",
      "type": "null"
    },
    "version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,199}$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "archive_sha256",
    "root_candidate",
    "root_mode_manifest_sha256",
    "binding_sha256"
  ],
  "title": "ArchiveSourceSnapshot",
  "type": "object",
  "x-skills-sdk-semantic-validation": {
    "entrypoint": "skills_sdk.core.schema_registry.SchemaRegistry.validate",
    "required_for": [
      "saved descriptor fingerprint, root, mode, revision and selected-child bindings",
      "ordered quality receipts and unchanged source captures",
      "admission decisions preserve supplied checks without authenticating provenance"
    ]
  }
}
