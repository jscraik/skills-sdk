{
  "$defs": {
    "IntakeChecks": {
      "additionalProperties": false,
      "description": "Boolean proof lanes required before canonical admission.",
      "properties": {
        "identity": {
          "title": "Identity",
          "type": "boolean"
        },
        "owner_unchanged": {
          "title": "Owner Unchanged",
          "type": "boolean"
        },
        "provenance": {
          "title": "Provenance",
          "type": "boolean"
        },
        "rights": {
          "title": "Rights",
          "type": "boolean"
        }
      },
      "required": [
        "identity",
        "provenance",
        "rights",
        "owner_unchanged"
      ],
      "title": "IntakeChecks",
      "type": "object"
    },
    "IntakeDecision": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "blocker_codes": {
                "minItems": 1
              }
            },
            "required": [
              "blocker_codes"
            ]
          },
          "if": {
            "properties": {
              "decision": {
                "const": "admit"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "blocker_codes": {
                "maxItems": 0
              },
              "checks": {
                "properties": {
                  "identity": {
                    "const": true
                  },
                  "owner_unchanged": {
                    "const": true
                  },
                  "provenance": {
                    "const": true
                  },
                  "rights": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Candidate-bound admission result with typed, explicit blockers.",
      "properties": {
        "blocker_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Blocker Codes",
          "type": "array"
        },
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "checks": {
          "$ref": "#/$defs/IntakeChecks"
        },
        "decision": {
          "$ref": "#/$defs/IntakeDecisionStatus"
        },
        "schema_version": {
          "const": "intake-decision/v1",
          "default": "intake-decision/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "decision",
        "checks"
      ],
      "title": "IntakeDecision",
      "type": "object"
    },
    "IntakeDecisionStatus": {
      "description": "Explicit intake result with no implicit waiver path.",
      "enum": [
        "admit",
        "block",
        "reject",
        "needs_owner_decision"
      ],
      "title": "IntakeDecisionStatus",
      "type": "string"
    },
    "NormalizedPackageV2": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "package_type": {
                "const": "skill"
              }
            },
            "required": [
              "package_type"
            ]
          },
          "then": {
            "properties": {
              "identity": {
                "properties": {
                  "package_type": {
                    "const": "skill"
                  }
                },
                "required": [
                  "package_type"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "package_type": {
                "const": "plugin"
              }
            },
            "required": [
              "package_type"
            ]
          },
          "then": {
            "properties": {
              "identity": {
                "properties": {
                  "package_type": {
                    "const": "plugin"
                  }
                },
                "required": [
                  "package_type"
                ]
              }
            }
          }
        }
      ],
      "description": "Additive normalized saved-release package; old v1 source stays unchanged.",
      "properties": {
        "dependencies": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "identity": {
          "discriminator": {
            "mapping": {
              "plugin": "#/$defs/PluginIdentity",
              "skill": "#/$defs/SkillIdentity"
            },
            "propertyName": "package_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SkillIdentity"
            },
            {
              "$ref": "#/$defs/PluginIdentity"
            }
          ],
          "title": "Identity"
        },
        "lifecycle": {
          "$ref": "#/$defs/PackageLifecycleState",
          "default": "normalized"
        },
        "owner": {
          "$ref": "#/$defs/PackageOwner"
        },
        "package_type": {
          "$ref": "#/$defs/PackageType"
        },
        "schema_version": {
          "const": "normalized-package/v2",
          "default": "normalized-package/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SavedReleasePackageSource"
        }
      },
      "required": [
        "package_type",
        "identity",
        "source",
        "owner"
      ],
      "title": "NormalizedPackageV2",
      "type": "object"
    },
    "OwnershipState": {
      "description": "Ownership posture at intake; it is not a runtime state.",
      "enum": [
        "canonical",
        "transitional",
        "external"
      ],
      "title": "OwnershipState",
      "type": "string"
    },
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "PackageFileRole": {
      "description": "The portable role of a file included in a package manifest.",
      "enum": [
        "skill_md",
        "readme",
        "reference",
        "script",
        "asset",
        "eval"
      ],
      "title": "PackageFileRole",
      "type": "string"
    },
    "PackageLifecycleState": {
      "description": "Portable lifecycle state for a normalized package candidate.",
      "enum": [
        "discovered",
        "normalized",
        "admitted",
        "blocked",
        "retired"
      ],
      "title": "PackageLifecycleState",
      "type": "string"
    },
    "PackageManifestFile": {
      "additionalProperties": false,
      "description": "One immutable file entry in a package manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/PackageFileRole"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "role"
      ],
      "title": "PackageManifestFile",
      "type": "object"
    },
    "PackageOwner": {
      "additionalProperties": false,
      "description": "Canonical ownership and rights evidence for one package candidate.",
      "properties": {
        "maintainer": {
          "minLength": 1,
          "title": "Maintainer",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "ownership_state": {
          "$ref": "#/$defs/OwnershipState"
        },
        "rights": {
          "$ref": "#/$defs/RightsStatus"
        },
        "schema_version": {
          "const": "package-owner/v1",
          "default": "package-owner/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "maintainer",
        "ownership_state",
        "rights"
      ],
      "title": "PackageOwner",
      "type": "object"
    },
    "PackageReceiptBlocker": {
      "additionalProperties": false,
      "description": "Stable typed blocker details for a package proof receipt.",
      "properties": {
        "code": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "PackageReceiptBlocker",
      "type": "object"
    },
    "PackageType": {
      "description": "Canonical package categories admitted by the Foundry.",
      "enum": [
        "skill",
        "plugin"
      ],
      "title": "PackageType",
      "type": "string"
    },
    "PluginIdentity": {
      "additionalProperties": false,
      "description": "Agent Plugins identity, independent of a client adapter.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "package_type": {
          "const": "plugin",
          "default": "plugin",
          "title": "Package Type",
          "type": "string"
        },
        "schema_version": {
          "const": "plugin-identity/v1",
          "default": "plugin-identity/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "name",
        "version"
      ],
      "title": "PluginIdentity",
      "type": "object"
    },
    "RightsStatus": {
      "additionalProperties": false,
      "description": "Rights evidence required before canonical admission.",
      "properties": {
        "basis": {
          "enum": [
            "authored",
            "license",
            "permission"
          ],
          "title": "Basis",
          "type": "string"
        },
        "evidence_ref": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        }
      },
      "required": [
        "basis",
        "license",
        "evidence_ref"
      ],
      "title": "RightsStatus",
      "type": "object"
    },
    "SavedReleasePackageSource": {
      "additionalProperties": false,
      "description": "Saved-source representation without a fabricated repository field.",
      "properties": {
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/SavedReleaseProvenance"
        },
        "schema_version": {
          "const": "saved-release-package-source/v1",
          "default": "saved-release-package-source/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "const": "external",
          "default": "external",
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "provenance"
      ],
      "title": "SavedReleasePackageSource",
      "type": "object"
    },
    "SavedReleaseProvenance": {
      "additionalProperties": false,
      "description": "One selected child bound to its containing saved-release snapshot.",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "saved-release-provenance/v1",
          "default": "saved-release-provenance/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/SavedReleaseSnapshot"
        }
      },
      "required": [
        "snapshot",
        "path",
        "candidate"
      ],
      "title": "SavedReleaseProvenance",
      "type": "object"
    },
    "SavedReleaseSnapshot": {
      "additionalProperties": false,
      "description": "Supplied immutable release binding; neither origin authentication nor admission.",
      "properties": {
        "archive_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Archive Sha256",
          "type": "string"
        },
        "binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "locator": {
          "maxLength": 2048,
          "title": "Locator",
          "type": "string"
        },
        "release_id": {
          "maxLength": 200,
          "title": "Release Id",
          "type": "string"
        },
        "root_candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "root_mode_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root Mode Manifest Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "saved-release-snapshot/v1",
          "default": "saved-release-snapshot/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "title": "Source Id",
          "type": "string"
        },
        "version": {
          "maxLength": 200,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "locator",
        "source_id",
        "release_id",
        "version",
        "archive_sha256",
        "root_candidate",
        "root_mode_manifest_sha256",
        "binding_sha256"
      ],
      "title": "SavedReleaseSnapshot",
      "type": "object"
    },
    "SkillIdentity": {
      "additionalProperties": false,
      "description": "Agent Skills identity, independent of runtime installation.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "package_type": {
          "const": "skill",
          "default": "skill",
          "title": "Package Type",
          "type": "string"
        },
        "schema_version": {
          "const": "skill-identity/v1",
          "default": "skill-identity/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "name",
        "version"
      ],
      "title": "SkillIdentity",
      "type": "object"
    },
    "SkillPackageFinding": {
      "additionalProperties": false,
      "description": "One stable, evidence-bound standalone-skill finding.",
      "properties": {
        "code": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/ValidationSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "SkillPackageFinding",
      "type": "object"
    },
    "SkillPackageIntakeContextV2": {
      "additionalProperties": false,
      "description": "Supplied saved-release provenance without a repository-shaped substitute.",
      "properties": {
        "checks": {
          "$ref": "#/$defs/IntakeChecks"
        },
        "owner": {
          "$ref": "#/$defs/PackageOwner",
          "properties": {
            "maintainer": {
              "not": {
                "pattern": "(?:^|[^A-Za-z0-9])(?:[aA][iI][zZ][aA][A-Za-z0-9_-]{35}|[aA][kK][iI][aA][A-Za-z0-9]{16}|[bB][eE][aA][rR][eE][rR]\\s+\\S+|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bBpP]-|(?:[aA][pP][iI][_-]?[kK][eE][yY]|[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[pP][aA][sS][sS][wW][oO][rR][dD]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL])[\\\"']?\\s*[:=])|-----BEGIN[ A-Z]* PRIVATE KEY-----|[A-Za-z][A-Za-z0-9+.-]*://[^/\\s]*@|[fF][iI][lL][eE]://|(?:^|[\\s(=:\\\"'])(?:/(?!/)[^\\s]|[A-Za-z]:[\\\\/])|\\\\\\\\|~[\\\\/]|\\$(?:\\{)?(?:HOME|USER|USERPROFILE)(?:\\})?[\\\\/]|%(?:HOME|USER|USERPROFILE)%[\\\\/]"
              },
              "type": "string"
            },
            "owner": {
              "not": {
                "pattern": "(?:^|[^A-Za-z0-9])(?:[aA][iI][zZ][aA][A-Za-z0-9_-]{35}|[aA][kK][iI][aA][A-Za-z0-9]{16}|[bB][eE][aA][rR][eE][rR]\\s+\\S+|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bBpP]-|(?:[aA][pP][iI][_-]?[kK][eE][yY]|[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[pP][aA][sS][sS][wW][oO][rR][dD]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL])[\\\"']?\\s*[:=])|-----BEGIN[ A-Z]* PRIVATE KEY-----|[A-Za-z][A-Za-z0-9+.-]*://[^/\\s]*@|[fF][iI][lL][eE]://|(?:^|[\\s(=:\\\"'])(?:/(?!/)[^\\s]|[A-Za-z]:[\\\\/])|\\\\\\\\|~[\\\\/]|\\$(?:\\{)?(?:HOME|USER|USERPROFILE)(?:\\})?[\\\\/]|%(?:HOME|USER|USERPROFILE)%[\\\\/]"
              },
              "type": "string"
            },
            "rights": {
              "properties": {
                "license": {
                  "not": {
                    "pattern": "(?:^|[^A-Za-z0-9])(?:[aA][iI][zZ][aA][A-Za-z0-9_-]{35}|[aA][kK][iI][aA][A-Za-z0-9]{16}|[bB][eE][aA][rR][eE][rR]\\s+\\S+|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bBpP]-|(?:[aA][pP][iI][_-]?[kK][eE][yY]|[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[pP][aA][sS][sS][wW][oO][rR][dD]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL])[\\\"']?\\s*[:=])|-----BEGIN[ A-Z]* PRIVATE KEY-----|[A-Za-z][A-Za-z0-9+.-]*://[^/\\s]*@|[fF][iI][lL][eE]://|(?:^|[\\s(=:\\\"'])(?:/(?!/)[^\\s]|[A-Za-z]:[\\\\/])|\\\\\\\\|~[\\\\/]|\\$(?:\\{)?(?:HOME|USER|USERPROFILE)(?:\\})?[\\\\/]|%(?:HOME|USER|USERPROFILE)%[\\\\/]"
                  },
                  "type": "string"
                }
              }
            }
          }
        },
        "schema_version": {
          "const": "skill-package-intake-context/v2",
          "default": "skill-package-intake-context/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SavedReleaseProvenance"
        }
      },
      "required": [
        "source",
        "owner",
        "checks"
      ],
      "title": "SkillPackageIntakeContextV2",
      "type": "object"
    },
    "SkillPackageValidation": {
      "additionalProperties": false,
      "description": "Read-only structural result for one standalone skill candidate.",
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageCandidateIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageManifestFile"
          },
          "title": "Files",
          "type": "array"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SkillPackageFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mutation_performed": {
          "const": false,
          "default": false,
          "title": "Mutation Performed",
          "type": "boolean"
