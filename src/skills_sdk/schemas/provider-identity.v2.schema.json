{
  "$id": "https://schemas.skills-sdk.dev/provider-identity.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Hardened provider identity for provider-bearing v2 contracts.",
  "properties": {
    "adapter_id": {
      "maxLength": 64,
      "not": {
        "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
      },
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_version_or_digest": {
      "maxLength": 128,
      "not": {
        "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$",
      "title": "Adapter Version Or Digest",
      "type": "string"
    },
    "model_id": {
      "allOf": [
        {
          "not": {
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
          }
        }
      ],
      "maxLength": 128,
      "not": {
        "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*(?:/[A-Za-z0-9][A-Za-z0-9._:+-]*)*$",
      "title": "Model Id",
      "type": "string"
    },
    "provider_id": {
      "maxLength": 64,
      "not": {
        "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
      },
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Provider Id",
      "type": "string"
    },
    "provider_kind": {
      "enum": [
        "llm",
        "agent",
        "external"
      ],
      "title": "Provider Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "provider-identity/v2",
      "default": "provider-identity/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "version_or_digest": {
      "maxLength": 128,
      "not": {
        "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$",
      "title": "Version Or Digest",
      "type": "string"
    }
  },
  "required": [
    "provider_id",
    "provider_kind",
    "model_id",
    "version_or_digest",
    "adapter_id",
    "adapter_version_or_digest"
  ],
  "title": "ProviderIdentityV2",
  "type": "object"
}
