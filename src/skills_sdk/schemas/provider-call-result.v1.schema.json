{
  "$defs": {
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "ProviderCostObservation": {
      "additionalProperties": false,
      "description": "Adapter-reported decimal cost observation, not an SDK measurement.",
      "properties": {
        "amount": {
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Amount",
          "type": "string"
        },
        "claimed_by": {
          "const": "adapter",
          "default": "adapter",
          "title": "Claimed By",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency",
        "observed_at"
      ],
      "title": "ProviderCostObservation",
      "type": "object"
    },
    "ProviderExecutionBlocker": {
      "additionalProperties": false,
      "description": "Typed, secret-free reason that execution could not proceed.",
      "properties": {
        "category": {
          "enum": [
            "policy",
            "safety",
            "provider",
            "adapter",
            "transport",
            "input",
            "unknown"
          ],
          "title": "Category",
          "type": "string"
        },
        "code": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "code",
        "category"
      ],
      "title": "ProviderExecutionBlocker",
      "type": "object"
    },
    "ProviderExecutionError": {
      "additionalProperties": false,
      "description": "Redacted adapter error classification with no raw provider response.",
      "properties": {
        "category": {
          "enum": [
            "provider",
            "adapter",
            "transport",
            "timeout",
            "policy",
            "unknown"
          ],
          "title": "Category",
          "type": "string"
        },
        "code": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "retryable",
        "evidence_refs"
      ],
      "title": "ProviderExecutionError",
      "type": "object"
    },
    "ProviderExecutionResult": {
      "additionalProperties": false,
      "description": "Adapter-supplied execution observation; the SDK does not run a provider.",
      "properties": {
        "blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderExecutionBlocker"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "case_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Case Id",
          "type": "string"
        },
        "cost_claimed": {
          "const": false,
          "title": "Cost Claimed",
          "type": "boolean"
        },
        "credentials_retained": {
          "const": false,
          "title": "Credentials Retained",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderExecutionError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "idempotency_key_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Idempotency Key Sha256",
          "type": "string"
        },
        "output_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Sha256"
        },
        "provider": {
          "$ref": "#/$defs/ProviderIdentityV2"
        },
        "raw_payloads_retained": {
          "const": false,
          "title": "Raw Payloads Retained",
          "type": "boolean"
        },
        "replay_of_result_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replay Of Result Id"
        },
        "replay_of_result_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of canonical JSON from the validated prior provider execution result model",
          "title": "Replay Of Result Sha256"
        },
        "request_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "description": "SHA-256 of canonical JSON from the validated provider execution request model",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "result_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Result Id",
          "type": "string"
        },
        "scenario_set_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Scenario Set Id",
          "type": "string"
        },
        "schema_version": {
          "const": "provider-execution-result/v1",
          "default": "provider-execution-result/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sdk_execution_performed": {
          "const": false,
          "title": "Sdk Execution Performed",
          "type": "boolean"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "blocked",
            "indeterminate"
          ],
          "title": "Status",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderUsageMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "result_id",
        "request_id",
        "request_sha256",
        "idempotency_key_sha256",
        "candidate",
        "scenario_set_id",
        "case_id",
        "provider",
        "status",
        "started_at",
        "finished_at",
        "sdk_execution_performed",
        "credentials_retained",
        "raw_payloads_retained",
        "cost_claimed"
      ],
      "title": "ProviderExecutionResult",
      "type": "object"
    },
    "ProviderIdentityV2": {
      "additionalProperties": false,
      "description": "Hardened provider identity for provider-bearing v2 contracts.",
      "properties": {
        "adapter_id": {
          "maxLength": 64,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version_or_digest": {
          "maxLength": 128,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$",
          "title": "Adapter Version Or Digest",
          "type": "string"
        },
        "model_id": {
          "allOf": [
            {
              "not": {
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
              }
            }
          ],
          "maxLength": 128,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*(?:/[A-Za-z0-9][A-Za-z0-9._:+-]*)*$",
          "title": "Model Id",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 64,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_kind": {
          "enum": [
            "llm",
            "agent",
            "external"
          ],
          "title": "Provider Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "provider-identity/v2",
          "default": "provider-identity/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "version_or_digest": {
          "maxLength": 128,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$",
          "title": "Version Or Digest",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "provider_kind",
        "model_id",
        "version_or_digest",
        "adapter_id",
        "adapter_version_or_digest"
      ],
      "title": "ProviderIdentityV2",
      "type": "object"
    },
    "ProviderUsageMetadata": {
      "additionalProperties": false,
      "description": "Optional adapter-reported unit counts; never a billing or cost claim.",
      "properties": {
        "input_units": {
          "minimum": 0,
          "title": "Input Units",
          "type": "integer"
        },
        "output_units": {
          "minimum": 0,
          "title": "Output Units",
          "type": "integer"
        },
        "total_units": {
          "minimum": 0,
          "title": "Total Units",
          "type": "integer"
        },
        "unit_kind": {
          "enum": [
            "tokens",
            "characters",
            "items",
            "provider_units"
          ],
          "title": "Unit Kind",
          "type": "string"
        }
      },
      "required": [
        "unit_kind",
        "input_units",
        "output_units",
        "total_units"
      ],
      "title": "ProviderUsageMetadata",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/provider-call-result.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Compact public evidence for one bounded provider-call orchestration.",
  "properties": {
    "cleanup_attempted": {
      "title": "Cleanup Attempted",
      "type": "boolean"
    },
    "cleanup_error_code": {
      "anyOf": [
        {
          "const": "cleanup_failed",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cleanup Error Code"
    },
    "cleanup_succeeded": {
      "title": "Cleanup Succeeded",
      "type": "boolean"
    },
    "cost": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderCostObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "event_count": {
      "maximum": 4096,
      "minimum": 0,
      "title": "Event Count",
      "type": "integer"
    },
    "event_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Event Sha256",
      "type": "string"
    },
    "execution": {
      "$ref": "#/$defs/ProviderExecutionResult"
    },
    "max_buffered_events": {
      "maximum": 8,
      "minimum": 0,
      "title": "Max Buffered Events",
      "type": "integer"
    },
    "max_inflight_pulls": {
      "const": 1,
      "default": 1,
      "title": "Max Inflight Pulls",
      "type": "integer"
    },
    "mode": {
      "enum": [
        "complete",
        "stream"
      ],
      "title": "Mode",
      "type": "string"
    },
    "output_bytes": {
      "maximum": 1048576,
      "minimum": 0,
      "title": "Output Bytes",
      "type": "integer"
    },
    "output_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Sha256"
    },
    "request_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Request Id",
      "type": "string"
    },
    "retry_attempts": {
      "const": 0,
      "default": 0,
      "title": "Retry Attempts",
      "type": "integer"
    },
    "schema_version": {
      "const": "provider-call-result/v1",
      "default": "provider-call-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "blocked",
        "indeterminate"
      ],
      "title": "Status",
      "type": "string"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderUsageMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "request_id",
    "mode",
    "status",
    "event_count",
    "output_bytes",
    "event_sha256",
    "max_buffered_events",
    "cleanup_attempted",
    "cleanup_succeeded",
    "execution"
  ],
  "title": "ProviderCallPublicResult",
  "type": "object"
}
