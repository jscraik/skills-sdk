{
  "$comment": "Validate cross-field lifecycle invariants with skills_sdk.core.schema_registry.SchemaRegistry.validate.",
  "$defs": {
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "RegistryIdentity": {
      "additionalProperties": false,
      "description": "Opaque, secret-free identity for one private registry namespace.",
      "properties": {
        "namespace": {
          "maxLength": 64,
          "not": {
            "pattern": "(^|[._:+-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Namespace",
          "type": "string"
        },
        "registry_id": {
          "maxLength": 64,
          "not": {
            "pattern": "(^|[._:+-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Registry Id",
          "type": "string"
        },
        "registry_kind": {
          "const": "private",
          "default": "private",
          "title": "Registry Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "registry-identity/v1",
          "default": "registry-identity/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "registry_id",
        "namespace"
      ],
      "title": "RegistryIdentity",
      "type": "object"
    },
    "RuntimeFile": {
