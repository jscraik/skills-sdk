{
  "$defs": {
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/plugin-presentation-copy-approval.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Supplied copy-accuracy assertion for the exact selected settings object.",
  "properties": {
    "accurate": {
      "const": true,
      "title": "Accurate",
      "type": "boolean"
    },
    "candidate": {
      "$ref": "#/$defs/PackageCandidateIdentity"
    },
    "evidence_ref": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Evidence Ref",
      "type": "string"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "openai_settings_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Openai Settings Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "plugin-presentation-copy-approval/v1",
      "default": "plugin-presentation-copy-approval/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "candidate",
    "openai_settings_sha256",
    "accurate",
    "evidence_ref",
    "evidence_sha256"
  ],
  "title": "PluginPresentationCopyApproval",
  "type": "object"
}
