{
  "$defs": {
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "PackageFileRole": {
      "description": "The portable role of a file included in a package manifest.",
      "enum": [
        "skill_md",
        "readme",
        "reference",
        "script",
        "asset",
        "eval"
      ],
      "title": "PackageFileRole",
      "type": "string"
    },
    "PackageManifestFile": {
      "additionalProperties": false,
      "description": "One immutable file entry in a package manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/PackageFileRole"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "role"
      ],
      "title": "PackageManifestFile",
      "type": "object"
    },
    "PackageManifestProvenance": {
      "additionalProperties": false,
      "description": "Portable provenance references used to build a package manifest.",
      "properties": {
        "builder": {
          "minLength": 1,
          "title": "Builder",
          "type": "string"
        },
        "source": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source",
          "type": "array"
        }
      },
      "required": [
        "source",
        "builder"
      ],
      "title": "PackageManifestProvenance",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/package-manifest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Candidate-bound package contents before distribution or installation.",
  "properties": {
    "candidate": {
      "$ref": "#/$defs/PackageCandidateIdentity"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/PackageManifestFile"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/PackageManifestProvenance"
    },
    "schema_version": {
      "const": "package-manifest/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "candidate",
    "version",
    "files",
    "provenance"
  ],
  "title": "PackageManifest",
  "type": "object"
}
