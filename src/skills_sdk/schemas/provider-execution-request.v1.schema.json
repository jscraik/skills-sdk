{
  "$defs": {
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "allOf": [
            {
              "not": {
                "pattern": "(^|[^A-Za-z0-9])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-|(?:[aA][pP][iI][_-]?[kK][eE][yY]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[pP][aA][sS][sS][wW][oO][rR][dD]|[sS][eE][cC][rR][eE][tT]|[tT][oO][kK][eE][nN])[\"']?\\s*[:=])"
              }
            },
            {
              "not": {
                "pattern": "(?:[fF][iI][lL][eE]:)?/+(?:[Uu][sS][eE][rR][sS]|[Hh][oO][mM][eE]|[Pp][rR][iI][vV][aA][tT][eE]|[Tt][mM][pP]|[Ww][oO][rR][kK][sS][pP][aA][cC][eE]|[Vv][aA][rR]/[Ff][oO][lL][dD][eE][rR][sS])/|[A-Za-z]:[\\\\/]+(?:[Uu][sS][eE][rR][sS]|[Hh][oO][mM][eE])[\\\\/]|(?:^|[\\\\/])(?:\\$(?:\\{)?(?:HOME|USER|USERPROFILE)(?:\\})?|%(?:HOME|USER|USERPROFILE)%|[Rr][Oo][Oo][Tt])(?:[\\\\/]|$)"
              }
            }
          ],
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "ProviderExecutionBlocker": {
      "additionalProperties": false,
      "description": "Typed, secret-free reason that execution could not proceed.",
      "properties": {
        "category": {
          "enum": [
            "policy",
            "safety",
            "provider",
            "adapter",
            "transport",
            "input",
            "unknown"
          ],
          "title": "Category",
          "type": "string"
        },
        "code": {
          "allOf": [
            {
              "not": {
                "pattern": "(^|[^A-Za-z0-9])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-|(?:[aA][pP][iI][_-]?[kK][eE][yY]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[pP][aA][sS][sS][wW][oO][rR][dD]|[sS][eE][cC][rR][eE][tT]|[tT][oO][kK][eE][nN])[\"']?\\s*[:=])"
              }
            },
            {
              "not": {
                "pattern": "(?:[fF][iI][lL][eE]:)?/+(?:[Uu][sS][eE][rR][sS]|[Hh][oO][mM][eE]|[Pp][rR][iI][vV][aA][tT][eE]|[Tt][mM][pP]|[Ww][oO][rR][kK][sS][pP][aA][cC][eE]|[Vv][aA][rR]/[Ff][oO][lL][dD][eE][rR][sS])/|[A-Za-z]:[\\\\/]+(?:[Uu][sS][eE][rR][sS]|[Hh][oO][mM][eE])[\\\\/]|(?:^|[\\\\/])(?:\\$(?:\\{)?(?:HOME|USER|USERPROFILE)(?:\\})?|%(?:HOME|USER|USERPROFILE)%|[Rr][Oo][Oo][Tt])(?:[\\\\/]|$)"
              }
            }
          ],
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "allOf": [
              {
                "not": {
                  "pattern": "(^|[^A-Za-z0-9])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-|(?:[aA][pP][iI][_-]?[kK][eE][yY]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[pP][aA][sS][sS][wW][oO][rR][dD]|[sS][eE][cC][rR][eE][tT]|[tT][oO][kK][eE][nN])[\"']?\\s*[:=])"
                }
              },
              {
                "not": {
                  "pattern": "(?:[fF][iI][lL][eE]:)?/+(?:[Uu][sS][eE][rR][sS]|[Hh][oO][mM][eE]|[Pp][rR][iI][vV][aA][tT][eE]|[Tt][mM][pP]|[Ww][oO][rR][kK][sS][pP][aA][cC][eE]|[Vv][aA][rR]/[Ff][oO][lL][dD][eE][rR][sS])/|[A-Za-z]:[\\\\/]+(?:[Uu][sS][eE][rR][sS]|[Hh][oO][mM][eE])[\\\\/]|(?:^|[\\\\/])(?:\\$(?:\\{)?(?:HOME|USER|USERPROFILE)(?:\\})?|%(?:HOME|USER|USERPROFILE)%|[Rr][Oo][Oo][Tt])(?:[\\\\/]|$)"
                }
              }
            ],
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "code",
        "category"
      ],
      "title": "ProviderExecutionBlocker",
      "type": "object"
    },
    "ProviderIdentityV2": {
      "additionalProperties": false,
      "description": "Hardened provider identity for provider-bearing v2 contracts.",
      "properties": {
        "adapter_id": {
          "maxLength": 64,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version_or_digest": {
          "maxLength": 128,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$",
          "title": "Adapter Version Or Digest",
          "type": "string"
        },
        "model_id": {
          "allOf": [
            {
              "not": {
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
              }
            }
          ],
          "maxLength": 128,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*(?:/[A-Za-z0-9][A-Za-z0-9._:+-]*)*$",
          "title": "Model Id",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 64,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_kind": {
          "enum": [
            "llm",
            "agent",
            "external"
          ],
          "title": "Provider Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "provider-identity/v2",
          "default": "provider-identity/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "version_or_digest": {
          "maxLength": 128,
          "not": {
            "pattern": "(^|[._:+/-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$",
          "title": "Version Or Digest",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "provider_kind",
        "model_id",
        "version_or_digest",
        "adapter_id",
        "adapter_version_or_digest"
      ],
      "title": "ProviderIdentityV2",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/provider-execution-request.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "prepared"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocker": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocker": {
            "$ref": "#/$defs/ProviderExecutionBlocker"
          }
        },
        "required": [
          "blocker"
        ]
      }
    }
  ],
  "description": "Prepared provider request metadata; this model performs no execution.",
  "properties": {
    "blocker": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderExecutionBlocker"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidate": {
      "$ref": "#/$defs/PackageCandidateIdentity"
    },
    "case_id": {
      "allOf": [
        {
          "not": {
            "pattern": "(^|[^A-Za-z0-9])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-|(?:[aA][pP][iI][_-]?[kK][eE][yY]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[pP][aA][sS][sS][wW][oO][rR][dD]|[sS][eE][cC][rR][eE][tT]|[tT][oO][kK][eE][nN])[\"']?\\s*[:=])"
          }
        },
        {
          "not": {
            "pattern": "(?:[fF][iI][lL][eE]:)?/+(?:[Uu][sS][eE][rR][sS]|[Hh][oO][mM][eE]|[Pp][rR][iI][vV][aA][tT][eE]|[Tt][mM][pP]|[Ww][oO][rR][kK][sS][pP][aA][cC][eE]|[Vv][aA][rR]/[Ff][oO][lL][dD][eE][rR][sS])/|[A-Za-z]:[\\\\/]+(?:[Uu][sS][eE][rR][sS]|[Hh][oO][mM][eE])[\\\\/]|(?:^|[\\\\/])(?:\\$(?:\\{)?(?:HOME|USER|USERPROFILE)(?:\\})?|%(?:HOME|USER|USERPROFILE)%|[Rr][Oo][Oo][Tt])(?:[\\\\/]|$)"
          }
        }
