      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Case Id",
      "type": "string"
    },
    "cost_claimed": {
      "const": false,
      "title": "Cost Claimed",
      "type": "boolean"
    },
    "credentials_included": {
      "const": false,
      "title": "Credentials Included",
      "type": "boolean"
    },
    "declared_capability": {
      "enum": [
        "response_generation",
        "agent_run",
        "embedding",
        "classification",
        "other"
