          },
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_kind": {
          "enum": [
            "llm",
            "agent",
            "external"
          ],
          "title": "Provider Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "provider-identity/v2",
          "default": "provider-identity/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "version_or_digest": {
          "maxLength": 128,
