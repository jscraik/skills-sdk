{
  "$defs": {
    "ArchiveSourceProvenance": {
      "additionalProperties": false,
      "description": "One child bound to a local archive snapshot, not a saved release.",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "archive-source-provenance/v1",
          "default": "archive-source-provenance/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/ArchiveSourceSnapshot"
        }
      },
      "required": [
        "snapshot",
        "path",
        "candidate"
      ],
      "title": "ArchiveSourceProvenance",
      "type": "object"
    },
    "ArchiveSourceSnapshot": {
      "additionalProperties": false,
      "description": "Local recovery binding, explicitly without upstream release identity.",
      "properties": {
        "acquisition": {
          "const": "user-supplied-recovery",
          "default": "user-supplied-recovery",
          "title": "Acquisition",
          "type": "string"
        },
        "archive_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Archive Sha256",
          "type": "string"
        },
        "binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "root_candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "root_mode_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root Mode Manifest Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "archive-source-snapshot/v1",
          "default": "archive-source-snapshot/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "upstream_release": {
          "default": null,
          "title": "Upstream Release",
          "type": "null"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,199}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "archive_sha256",
        "root_candidate",
        "root_mode_manifest_sha256",
        "binding_sha256"
      ],
      "title": "ArchiveSourceSnapshot",
      "type": "object"
    },
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/archive-package-source.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Represent archive acquisition without repository or remote identifiers.",
  "properties": {
    "package_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Package Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ArchiveSourceProvenance"
    },
    "schema_version": {
      "const": "archive-package-source/v1",
      "default": "archive-package-source/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_kind": {
      "const": "archive",
      "default": "archive",
      "title": "Source Kind",
      "type": "string"
    }
  },
  "required": [
    "package_id",
    "provenance"
  ],
  "title": "ArchivePackageSource",
  "type": "object",
  "x-skills-sdk-semantic-validation": {
    "entrypoint": "skills_sdk.core.schema_registry.SchemaRegistry.validate",
    "required_for": [
      "saved descriptor fingerprint, root, mode, revision and selected-child bindings",
      "ordered quality receipts and unchanged source captures",
      "admission decisions preserve supplied checks without authenticating provenance"
    ]
  }
}
