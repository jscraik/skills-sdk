{
  "$defs": {
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "ScenarioQualityFinding": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "code": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ScenarioQualityFinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/scorer-quality.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calibration_probe_count": {
      "default": 0,
      "minimum": 0,
      "title": "Calibration Probe Count",
      "type": "integer"
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_performed": {
      "const": false,
      "default": false,
      "title": "Execution Performed",
      "type": "boolean"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ScenarioQualityFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "mutation_performed": {
      "const": false,
      "default": false,
      "title": "Mutation Performed",
      "type": "boolean"
    },
    "network_used": {
      "const": false,
      "default": false,
      "title": "Network Used",
      "type": "boolean"
    },
    "pass_threshold": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pass Threshold"
    },
    "schema_version": {
      "const": "scorer-quality/v1",
      "default": "scorer-quality/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scorer_id": {
      "default": "",
      "title": "Scorer Id",
      "type": "string"
    },
    "scorer_version_or_digest": {
      "default": "",
      "title": "Scorer Version Or Digest",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "title": "ScorerQualityReceipt",
  "type": "object"
}
