{
  "$defs": {
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "ScenarioQualityAppliedPolicy": {
      "additionalProperties": false,
      "properties": {
        "minimum_negative_or_edge": {
          "const": 1,
          "default": 1,
          "title": "Minimum Negative Or Edge",
          "type": "integer"
        },
        "minimum_pressure_or_regression": {
          "const": 1,
          "default": 1,
          "title": "Minimum Pressure Or Regression",
          "type": "integer"
        },
        "minimum_release_cases": {
          "const": 8,
          "default": 8,
          "title": "Minimum Release Cases",
          "type": "integer"
        }
      },
      "title": "ScenarioQualityAppliedPolicy",
      "type": "object"
    },
    "ScenarioQualityFinding": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "code": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ScenarioQualityFinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/scenario-quality.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "candidate": {
            "$ref": "#/$defs/PackageCandidateIdentity"
          },
          "findings": {
            "maxItems": 0
          },
          "scenario_count": {
            "minimum": 1
          }
        },
        "required": [
          "candidate",
          "scenario_count"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        },
        "required": [
          "findings"
        ]
      }
    },
    {
      "else": {
        "properties": {
          "scenario_set_id": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "scope": {
            "const": "release"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "scenario_set_id": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          }
        },
        "required": [
          "scenario_set_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "release"
          },
          "status": {
            "const": "pass"
          }
        },
        "required": [
          "status",
          "scope"
        ]
      },
      "then": {
        "properties": {
          "negative_or_edge_count": {
            "minimum": 1
          },
          "pressure_or_regression_count": {
            "minimum": 1
          },
          "scenario_count": {
            "minimum": 8
          }
        }
      }
    }
  ],
  "properties": {
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "effective_policy": {
      "$ref": "#/$defs/ScenarioQualityAppliedPolicy"
    },
    "execution_performed": {
      "const": false,
      "default": false,
      "title": "Execution Performed",
      "type": "boolean"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ScenarioQualityFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "mutation_performed": {
      "const": false,
      "default": false,
      "title": "Mutation Performed",
      "type": "boolean"
    },
    "negative_or_edge_count": {
      "default": 0,
      "minimum": 0,
      "title": "Negative Or Edge Count",
      "type": "integer"
    },
    "network_used": {
      "const": false,
      "default": false,
      "title": "Network Used",
      "type": "boolean"
    },
    "pressure_or_regression_count": {
      "default": 0,
      "minimum": 0,
      "title": "Pressure Or Regression Count",
      "type": "integer"
    },
    "scenario_count": {
      "minimum": 0,
      "title": "Scenario Count",
      "type": "integer"
    },
    "scenario_set_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Set Id"
    },
    "schema_version": {
      "const": "scenario-quality/v1",
      "default": "scenario-quality/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "enum": [
        "all",
        "release"
      ],
      "title": "Scope",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "status",
    "scenario_count",
    "effective_policy"
  ],
  "title": "ScenarioQualityReceipt",
  "type": "object"
}
