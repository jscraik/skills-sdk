{
  "$defs": {
    "ClaimCoverage": {
      "additionalProperties": false,
      "properties": {
        "case_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Case Ids",
          "type": "array"
        },
        "claim_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Claim Id",
          "type": "string"
        },
        "gap_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Gap Ids",
          "type": "array"
        }
      },
      "required": [
        "claim_id"
      ],
      "title": "ClaimCoverage",
      "type": "object"
    },
    "CoverageClaim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement"
      ],
      "title": "CoverageClaim",
      "type": "object"
    },
    "CoverageGap": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason",
        "owner"
      ],
      "title": "CoverageGap",
      "type": "object"
    },
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
    "ScenarioCoveragePlan": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/CoverageClaim"
          },
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        },
        "gaps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CoverageGap"
          },
          "title": "Gaps",
          "type": "array"
        },
        "mappings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClaimCoverage"
          },
          "title": "Mappings",
          "type": "array"
        },
        "scenario_set_id": {
          "minLength": 1,
          "title": "Scenario Set Id",
          "type": "string"
        },
        "schema_version": {
          "const": "scenario-coverage-plan/v1",
          "default": "scenario-coverage-plan/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "scenario_set_id",
        "claims"
      ],
      "title": "ScenarioCoveragePlan",
      "type": "object"
    },
    "ScenarioQualityAppliedPolicyV2": {
      "additionalProperties": false,
      "properties": {
        "maximum_release_cases": {
          "const": 10,
          "title": "Maximum Release Cases",
          "type": "integer"
        },
        "minimum_negative_or_edge": {
          "const": 1,
          "title": "Minimum Negative Or Edge",
          "type": "integer"
        },
        "minimum_pressure_or_regression": {
          "const": 1,
          "title": "Minimum Pressure Or Regression",
          "type": "integer"
        },
        "minimum_release_cases": {
          "const": 10,
          "title": "Minimum Release Cases",
          "type": "integer"
        },
        "target_release_cases": {
          "const": 10,
          "title": "Target Release Cases",
          "type": "integer"
        }
      },
      "required": [
        "minimum_release_cases",
        "target_release_cases",
        "maximum_release_cases",
        "minimum_pressure_or_regression",
        "minimum_negative_or_edge"
      ],
      "title": "ScenarioQualityAppliedPolicyV2",
      "type": "object"
    },
    "ScenarioQualityFinding": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "code": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ScenarioQualityFinding",
      "type": "object"
    },
    "ScenarioQualityReceiptV2": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageCandidateIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effective_policy": {
          "$ref": "#/$defs/ScenarioQualityAppliedPolicyV2"
        },
        "execution_performed": {
          "const": false,
          "default": false,
          "title": "Execution Performed",
          "type": "boolean"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScenarioQualityFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "mutation_performed": {
          "const": false,
          "default": false,
          "title": "Mutation Performed",
          "type": "boolean"
        },
        "negative_or_edge_count": {
          "default": 0,
          "minimum": 0,
          "title": "Negative Or Edge Count",
          "type": "integer"
        },
        "network_used": {
          "const": false,
          "default": false,
          "title": "Network Used",
          "type": "boolean"
        },
        "pressure_or_regression_count": {
          "default": 0,
          "minimum": 0,
          "title": "Pressure Or Regression Count",
          "type": "integer"
        },
        "scenario_count": {
          "minimum": 0,
          "title": "Scenario Count",
          "type": "integer"
        },
        "scenario_set_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Set Id"
        },
        "schema_version": {
          "const": "scenario-quality/v2",
          "default": "scenario-quality/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "enum": [
            "all",
            "release"
          ],
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "status",
        "scenario_count",
        "effective_policy"
      ],
      "title": "ScenarioQualityReceiptV2",
      "type": "object"
    }
  },
  "$id": "https://schemas.skills-sdk.dev/scenario-coverage.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_case_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Active Case Ids",
      "type": "array"
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage_complete": {
      "default": false,
      "title": "Coverage Complete",
      "type": "boolean"
    },
    "execution_performed": {
      "const": false,
      "default": false,
      "title": "Execution Performed",
      "type": "boolean"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ScenarioQualityFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "mutation_performed": {
      "const": false,
      "default": false,
      "title": "Mutation Performed",
      "type": "boolean"
    },
    "network_used": {
      "const": false,
      "default": false,
      "title": "Network Used",
      "type": "boolean"
    },
    "open_gap_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Open Gap Ids",
      "type": "array"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScenarioCoveragePlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "promotion_authorized": {
      "const": false,
      "default": false,
      "title": "Promotion Authorized",
      "type": "boolean"
    },
    "quality": {
      "$ref": "#/$defs/ScenarioQualityReceiptV2"
    },
    "scenario_set_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Scenario Set Id"
    },
    "schema_version": {
      "const": "scenario-coverage/v1",
      "default": "scenario-coverage/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "candidate",
    "scenario_set_id",
    "status",
    "quality"
  ],
  "title": "ScenarioCoverageResult",
  "type": "object"
}
