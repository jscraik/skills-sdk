      "type": "boolean"
    },
    "network_used": {
      "const": false,
      "default": false,
      "title": "Network Used",
      "type": "boolean"
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/NativeCalibrationReceipt"
