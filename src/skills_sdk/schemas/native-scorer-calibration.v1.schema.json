        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parameters": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexNativeJudgeParameters"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prompt_version": {
      "default": "",
      "title": "Prompt Version",
      "type": "string"
    },
    "schema_version": {
      "const": "native-scorer-calibration/v1",
      "default": "native-scorer-calibration/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scorer_id": {
      "default": "",
      "title": "Scorer Id",
