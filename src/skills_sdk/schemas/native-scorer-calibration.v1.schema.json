{
  "$defs": {
    "CodexNativeJudgeParameters": {
      "additionalProperties": false,
      "description": "Frozen requested CLI controls; temperature is explicitly unavailable.",
      "properties": {
        "apps": {
          "const": false,
          "default": false,
          "title": "Apps",
          "type": "boolean"
        },
        "cli_version": {
          "minLength": 1,
          "title": "Cli Version",
          "type": "string"
        },
        "disabled_mcp_servers": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Disabled Mcp Servers",
          "type": "array"
        },
        "ephemeral": {
          "const": true,
          "default": true,
          "title": "Ephemeral",
          "type": "boolean"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "plugins": {
          "const": false,
          "default": false,
          "title": "Plugins",
          "type": "boolean"
        },
        "reasoning_effort": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Reasoning Effort",
          "type": "string"
        },
        "sandbox": {
          "const": "read-only",
          "default": "read-only",
          "title": "Sandbox",
          "type": "string"
        },
        "schema_version": {
          "const": "codex-native-judge-parameters/v1",
          "default": "codex-native-judge-parameters/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "shell_tool": {
          "const": false,
          "default": false,
          "title": "Shell Tool",
          "type": "boolean"
        },
        "temperature": {
          "default": null,
          "title": "Temperature",
          "type": "null"
        },
        "temperature_control": {
          "const": "not_exposed_by_codex_cli",
          "default": "not_exposed_by_codex_cli",
          "title": "Temperature Control",
          "type": "string"
        },
        "timeout_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "trial_count": {
          "const": 1,
          "default": 1,
          "title": "Trial Count",
          "type": "integer"
        },
        "web_search": {
          "const": "disabled",
          "default": "disabled",
          "title": "Web Search",
          "type": "string"
        }
      },
      "required": [
        "model",
        "cli_version",
        "reasoning_effort",
        "timeout_seconds",
        "disabled_mcp_servers"
      ],
      "title": "CodexNativeJudgeParameters",
      "type": "object"
    },
    "HeldOutCalibrationProbe": {
      "additionalProperties": false,
      "description": "A host-retained label bound to the exact held-out provider output.",
      "properties": {
        "expected_label": {
          "enum": [
            "pass",
            "fail"
          ],
          "title": "Expected Label",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "probe_id": {
          "minLength": 1,
          "title": "Probe Id",
          "type": "string"
        }
      },
      "required": [
        "probe_id",
        "output_sha256",
        "expected_label"
      ],
      "title": "HeldOutCalibrationProbe",
      "type": "object"
    },
    "NativeCalibrationPlan": {
      "additionalProperties": false,
      "description": "Separate native family; preserve all existing candidate and safety gates.",
      "properties": {
        "assertion_contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assertion Contract Sha256",
          "type": "string"
        },
        "candidate": {
          "$ref": "#/$defs/PackageCandidateIdentity"
        },
        "judge": {
          "$ref": "#/$defs/ProviderIdentityV2"
        },
        "parameters": {
          "$ref": "#/$defs/CodexNativeJudgeParameters"
        },
        "policy": {
          "$ref": "#/$defs/ScorerCalibrationAppliedPolicy"
        },
        "probes": {
          "items": {
            "$ref": "#/$defs/HeldOutCalibrationProbe"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Probes",
          "type": "array"
        },
        "rubric_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rubric Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "native-calibration-plan/v1",
          "default": "native-calibration-plan/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scorer": {
          "$ref": "#/$defs/ScorerProfile"
        }
      },
      "required": [
        "candidate",
        "scorer",
        "judge",
        "parameters",
        "policy",
        "assertion_contract_sha256",
        "probes",
        "rubric_sha256"
      ],
      "title": "NativeCalibrationPlan",
      "type": "object"
    },
    "NativeCalibrationReceipt": {
      "additionalProperties": false,
      "description": "Native callback proof; never external authenticity or release clearance.",
      "properties": {
        "blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageSafetyBlocker"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_scope": {
          "const": "observed_adapter_callbacks",
          "default": "observed_adapter_callbacks",
          "title": "Evidence Scope",
          "type": "string"
        },
        "external_authenticity_verified": {
          "const": false,
          "default": false,
          "title": "External Authenticity Verified",
          "type": "boolean"
        },
        "judge_execution_performed": {
          "title": "Judge Execution Performed",
          "type": "boolean"
        },
        "judge_invocation_count": {
          "maximum": 128,
          "minimum": 0,
          "title": "Judge Invocation Count",
          "type": "integer"
        },
        "mutation_performed": {
          "const": false,
          "default": false,
          "title": "Mutation Performed",
          "type": "boolean"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeCalibrationPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "promotion_authorized": {
          "const": false,
          "default": false,
          "title": "Promotion Authorized",
          "type": "boolean"
        },
        "results": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservedCalibrationProbeResult"
          },
          "title": "Results",
          "type": "array"
        },
        "schema_version": {
          "const": "native-calibration/v1",
          "default": "native-calibration/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "judge_invocation_count",
        "judge_execution_performed"
      ],
      "title": "NativeCalibrationReceipt",
      "type": "object"
    },
    "ObservedCalibrationProbeResult": {
      "additionalProperties": false,
      "description": "Redacted per-output execution result; raw outputs never enter the receipt.",
      "properties": {
        "expected_label": {
          "enum": [
            "pass",
            "fail"
          ],
          "title": "Expected Label",
          "type": "string"
        },
        "judge_result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Judge Result Sha256",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "predicted_label": {
          "enum": [
            "pass",
            "fail"
          ],
          "title": "Predicted Label",
          "type": "string"
        },
        "probe_id": {
          "minLength": 1,
          "title": "Probe Id",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "trial_index": {
          "minimum": 0,
          "title": "Trial Index",
          "type": "integer"
        }
      },
      "required": [
        "probe_id",
        "trial_index",
        "output_sha256",
        "expected_label",
        "predicted_label",
        "score",
        "judge_result_sha256"
      ],
      "title": "ObservedCalibrationProbeResult",
      "type": "object"
    },
    "PackageCandidateIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity shared by intake and downstream proof receipts.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "const": "package-candidate/v1",
          "default": "package-candidate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "source_revision",
        "content_sha256"
      ],
      "title": "PackageCandidateIdentity",
      "type": "object"
    },
