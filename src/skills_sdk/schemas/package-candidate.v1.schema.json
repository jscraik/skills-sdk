{
  "$id": "https://schemas.skills-sdk.dev/package-candidate.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable identity shared by intake and downstream proof receipts.",
  "properties": {
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "package_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Package Id",
      "type": "string"
    },
    "schema_version": {
      "const": "package-candidate/v1",
      "default": "package-candidate/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Revision",
      "type": "string"
    }
  },
  "required": [
    "package_id",
    "source_revision",
    "content_sha256"
  ],
  "title": "PackageCandidateIdentity",
  "type": "object"
}
