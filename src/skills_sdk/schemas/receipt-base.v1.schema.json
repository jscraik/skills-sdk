{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skills-sdk.dev/receipt-base.v1.schema.json",
  "title": "Candidate-bound proof receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "candidate",
    "lane",
    "status",
    "started_at",
    "finished_at",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "receipt-base/v1"},
    "receipt_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "candidate": {"$ref": "package-identity.v1.schema.json"},
    "lane": {"enum": ["source", "validation", "runtime", "provider", "distribution", "publication"]},
    "status": {"enum": ["pass", "fail", "blocked"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$"
      },
      "uniqueItems": true
    },
    "blocker": {"$ref": "blocker.v1.schema.json"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {"required": ["blocker"]},
      "else": {"not": {"required": ["blocker"]}}
    }
  ]
}
