{
  "$defs": {
    "RegistryIdentity": {
      "additionalProperties": false,
      "description": "Opaque, secret-free identity for one private registry namespace.",
      "properties": {
        "namespace": {
          "maxLength": 64,
          "not": {
            "pattern": "(^|[._:+-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Namespace",
          "type": "string"
        },
        "registry_id": {
          "maxLength": 64,
          "not": {
            "pattern": "(^|[._:+-])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-)"
          },
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Registry Id",
          "type": "string"
        },
        "registry_kind": {
          "const": "private",
          "default": "private",
          "title": "Registry Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "registry-identity/v1",
          "default": "registry-identity/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "registry_id",
        "namespace"
      ],
      "title": "RegistryIdentity",
      "type": "object"
    },
    "RegistryPublicText": {
      "allOf": [
        {
          "not": {
            "pattern": "(^|[^A-Za-z0-9])(?:[aA][iI][zZ][aA]|[aA][kK][iI][aA]|[bB][eE][aA][rR][eE][rR]|[gG][hH][pP]_|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[hH][fF]_|[sS][kK]-|[xX][oO][xX][bB]-|[xX][oO][xX][pP]-|-----[Bb][Ee][Gg][Ii][Nn](?: [A-Za-z0-9]+)? [Pp][Rr][Ii][Vv][Aa][Tt][Ee] [Kk][Ee][Yy]-----|[eE][yY][jJ][A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+|(?:[cC][lL][iI][eE][nN][tT]|[aA][cC][cC][eE][sS][sS])[_-]?(?:[sS][eE][cC][rR][eE][tT]|[tT][oO][kK][eE][nN]|[kK][eE][yY](?:[_-]?[iI][dD])?)(?:[_-][A-Za-z0-9]+)*(?![A-Za-z0-9_-])|(?:[cC][lL][iI][eE][nN][tT]|[aA][cC][cC][eE][sS][sS])[_-]?(?:[sS][eE][cC][rR][eE][tT]|[tT][oO][kK][eE][nN]|[kK][eE][yY](?:[_-]?[iI][dD])?)[A-Za-z0-9_-]*[\\\"']?[\\s\\u001c-\\u001f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[:=]|(?:(?:[sS][sS][hH]_)?[pP][rR][iI][vV][aA][tT][eE][_-]?[kK][eE][yY]|[aA][pP][iI][_-]?[kK][eE][yY]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[pP][aA][sS][sS][wW][oO][rR][dD]|[sS][eE][cC][rR][eE][tT]|[tT][oO][kK][eE][nN])(?:[_-][A-Za-z0-9]+)*[\\\"']?[\\s\\u001c-\\u001f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[:=])|[a-z][A-Z](?:piKey|ccessToken|uthToken|assword|rivateKey|ecret|oken)(?:[_-][A-Za-z0-9]+)*[\\\"']?[\\s\\u001c-\\u001f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[:=]"
          }
        },
        {
          "not": {
            "pattern": "(?:[fF][iI][lL][eE]:)/+|(?:^|[^A-Za-z0-9])\\$[A-Za-z_][A-Za-z0-9_]*/|(?:^|[^A-Za-z0-9._-])(?:[A-Za-z0-9._-]+\\\\)+[A-Za-z0-9._-]+|(?:^|[^A-Za-z0-9])\\\\|(?:^|[\\s\\u001c-\\u001f\\u0085\\[({=:;'\\\"`<@*])/(?!/)|(?:^|[\\s\\u001c-\\u001f\\u0085\\[({=;'\\\"`<@*])//|(?:^|[^A-Za-z0-9/])/(?:[Uu][sS][eE][rR][sS]|[Hh][oO][mM][eE]|[Pp][rR][iI][vV][aA][tT][eE]|[Tt][mM][pP]|[Ww][oO][rR][kK][sS][pP][aA][cC][eE]|[Vv][aA][rR]/[Ff][oO][lL][dD][eE][rR][sS]|[Rr][Oo][Oo][Tt])/|(?:^|[^A-Za-z0-9.:/])(?:[A-Za-z0-9._-]+/)+(?:[Uu][sS][eE][rR][sS]|[Hh][oO][mM][eE]|[Pp][rR][iI][vV][aA][tT][eE]|[Tt][mM][pP]|[Ww][oO][rR][kK][sS][pP][aA][cC][eE]|[Vv][aA][rR]/[Ff][oO][lL][dD][eE][rR][sS]|[Rr][Oo][Oo][Tt])/|(?:^|[^A-Za-z0-9])[A-Za-z]:"
          }
        }
      ]
    }
  },
  "$id": "https://schemas.skills-sdk.dev/registry-preparation-request.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Secret-free caller intent for one local registry preparation.",
  "properties": {
    "evidence": {
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/RegistryPublicText"
          }
        ],
        "minLength": 1,
        "pattern": "^(?=.*\\S)(?!.*[\\r\\n])(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![^/]*:)(?!.*//)(?!.*(?:^|/)\\./)(?!.*\\/$)[\\s\\S]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array",
      "uniqueItems": true
    },
    "package_name": {
      "allOf": [
        {
          "$ref": "#/$defs/RegistryPublicText"
        }
      ],
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Package Name",
      "type": "string"
    },
    "registry": {
      "$ref": "#/$defs/RegistryIdentity"
    },
    "schema_version": {
      "const": "registry-preparation-request/v1",
      "default": "registry-preparation-request/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "allOf": [
        {
          "$ref": "#/$defs/RegistryPublicText"
        }
      ],
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "registry",
    "package_name",
    "version",
    "evidence"
  ],
  "title": "RegistryPreparationRequest",
  "type": "object"
}
