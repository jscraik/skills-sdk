        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array",
      "uniqueItems": true
    },
    "package_name": {
      "allOf": [
        {
          "$ref": "#/$defs/RegistryPublicText"
        }
      ],
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
